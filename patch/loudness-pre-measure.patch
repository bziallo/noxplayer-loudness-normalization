+/**
+ * Measure (and land) the gain *before* the track starts playing, so the first
+ * sample is already at the right level — no "it gets quieter/louder after two
+ * seconds" surprise.
+ *
+ * Cached tracks return instantly; uncached ones block for at most `timeoutMs`
+ * (the measurement keeps running in the background afterwards, exactly like the
+ * old behaviour, when it does not finish in time).
+ */
+export const prepareBeforePlay = async (
+  opts: NormalizeOptions,
+  timeoutMs = 4000,
+) => {
+  const setting = resolveLoudnessSetting(opts.playerSetting);
+  if (!setting.enabled || setting.bypass) return lastStatus;
+  // a cache hit was already applied synchronously by resolveForPlayback
+  if (memCache.has(opts.song.id)) return lastStatus;
+
+  emitStatus({
+    songId: opts.song.id,
+    name: opts.song.name,
+    stage: 'measuring',
+    reason: '播放前测量中（避免开头音量突变）',
+  });
+
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const cap = new Promise<void>((resolve) => {
+    timer = setTimeout(resolve, timeoutMs);
+  });
+  try {
+    await Promise.race([
+      normalizeSong({ ...opts, measureImmediately: true }),
+      cap,
+    ]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+  return lastStatus;
+};
