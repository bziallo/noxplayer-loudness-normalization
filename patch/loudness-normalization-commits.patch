@@ -0,0 +1,242 @@
+/* ================================================================
+ * sidx.ts — fMP4 segment index parsing (pure functions, no side effects).
+ *
+ * Ported from Bilibili_LoudNorm/src/sidx.js (MIT, (c) 2026 Moxia9527).
+ *
+ * B站 audio is a single fMP4 file:
+ *     ftyp -> moov(with mvex/trex) -> sidx -> [moof+mdat] x N
+ *
+ * Reading a few KB of index is enough to know where every segment lives, so a
+ * whole track can be sampled without downloading it.
+ *
+ * Box layout (ISO/IEC 14496-12 8.16.3):
+ *   box header(8|16) + version(1) flags(3) reference_ID(4)
+ *   timescale(4) earliest_presentation_time(v0:4 / v1:8)
+ *   first_offset(v0:4 / v1:8) reserved(2) reference_count(2)
+ *   then reference_count entries of 12 bytes:
+ *     type(1bit) + referenced_size(31bit) | subsegment_duration(4) | SAP(4)
+ * ================================================================ */
+import { ParsedSidx, SidxRef } from './types';
+
+export interface BoxHeader {
+  type: string;
+  size: number;
+  headerSize: number;
+  offset: number;
+}
+
+const toView = (input: ArrayBuffer | Uint8Array | DataView) => {
+  if (input instanceof DataView) return input;
+  if (input instanceof Uint8Array) {
+    return new DataView(input.buffer, input.byteOffset, input.byteLength);
+  }
+  return new DataView(input);
+};
+
+/** Read one box header. Returns null when the offset is out of range. */
+export const readBoxHeader = (
+  view: DataView,
+  offset: number,
+): BoxHeader | null => {
+  if (offset + 8 > view.byteLength) return null;
+
+  const size32 = view.getUint32(offset);
+  const type = String.fromCharCode(
+    view.getUint8(offset + 4),
+    view.getUint8(offset + 5),
+    view.getUint8(offset + 6),
+    view.getUint8(offset + 7),
+  );
+
+  let size = size32;
+  let headerSize = 8;
+
+  if (size32 === 1) {
+    // largesize: 64 bit
+    const hi = view.getUint32(offset + 8);
+    const lo = view.getUint32(offset + 12);
+    size = hi * 4294967296 + lo;
+    headerSize = 16;
+  } else if (size32 === 0) {
+    // extends to the end of the buffer
+    size = view.byteLength - offset;
+  }
+
+  if (size < headerSize) return null;
+  return { type, size, headerSize, offset };
+};
+
+/** Walk the top level boxes, returning the first box with the given type. */
+export const findBox = (
+  input: ArrayBuffer | Uint8Array | DataView,
+  type: string,
+): BoxHeader | null => {
+  const view = toView(input);
+  let off = 0;
+  let guard = 0;
+  while (off + 8 <= view.byteLength && guard < 64) {
+    guard += 1;
+    const header = readBoxHeader(view, off);
+    if (!header) return null;
+    if (header.type === type) return header;
+    off += header.size;
+  }
+  return null;
+};
+
+/** true when the bytes start with the given box type (self check helper). */
+export const startsWithBox = (
+  input: ArrayBuffer | Uint8Array | DataView,
+  type: string,
+): boolean => {
+  if (!input) return false;
+  const view = toView(input);
+  if (view.byteLength < 8) return false;
+  const actual = String.fromCharCode(
+    view.getUint8(4),
+    view.getUint8(5),
+    view.getUint8(6),
+    view.getUint8(7),
+  );
+  return actual === type;
+};
+
+/**
+ * Parse a sidx box.
+ *
+ * `anchor` is critical: ISO/IEC 14496-12 defines `first_offset` relative to
+ * the byte right after the sidx box, not to the start of the file. Parsing
+ * with anchor=0 shifts every segment by `ftyp+moov+sidx`, which shows up as
+ * "only segment 0 decodes".
+ *
+ * @param input bytes starting at the sidx box
+ * @param anchor absolute byte offset right after the sidx box
+ */
+export const parseSidx = (
+  input: ArrayBuffer | Uint8Array | DataView,
+  anchor: number,
+): ParsedSidx | null => {
+  if (!input) return null;
+  const base = Number.isFinite(anchor) ? anchor : 0;
+  const view = toView(input);
+
+  const found = findBox(view, 'sidx');
+  if (!found) return null;
+
+  let p = found.offset + found.headerSize;
+
+  const version = view.getUint8(p);
+  p += 4; // version(1) + flags(3)
+  p += 4; // reference_ID
+
+  const timescale = view.getUint32(p);
+  p += 4;
+  if (!timescale) return null;
+
+  let earliest: number;
+  let firstOffset: number;
+  if (version === 1) {
+    earliest = view.getUint32(p) * 4294967296 + view.getUint32(p + 4);
+    p += 8;
+    firstOffset = view.getUint32(p) * 4294967296 + view.getUint32(p + 4);
+    p += 8;
+  } else {
+    earliest = view.getUint32(p);
+    p += 4;
+    firstOffset = view.getUint32(p);
+    p += 4;
+  }
+
+  p += 2; // reserved
+  const count = view.getUint16(p);
+  p += 2;
+
+  const refs: SidxRef[] = [];
+  let cursor = base + firstOffset;
+  let t = earliest;
+
+  for (let i = 0; i < count; i += 1) {
+    if (p + 12 > view.byteLength) break;
+    const sizeWithType = view.getUint32(p);
+    const size = sizeWithType & 0x7fffffff; // low 31 bits
+    const duration = view.getUint32(p + 4);
+    p += 12;
+
+    refs.push({
+      index: i,
+      t: t / timescale,
+      duration: duration / timescale,
+      size,
+      offset: cursor,
+    });
+
+    cursor += size;
+    t += duration;
+  }
+
+  return {
+    version,
+    timescale,
+    earliestPresentationTime: earliest / timescale,
+    firstOffset,
+    anchor: base,
+    refs,
+    endOffset: cursor,
+  };
+};
+
+/**
+ * Self check: anchor + firstOffset + sum(refs.size) must equal the file size
+ * (true for every B站 audio file measured so far).
+ */
+export const verifySidx = (
+  parsed: ParsedSidx | null,
+  contentLength?: number,
+) => {
+  if (!parsed || !Number.isFinite(contentLength)) {
+    return { ok: null as boolean | null, reason: 'no-data' };
+  }
+  const diff = parsed.endOffset - (contentLength as number);
+  return { ok: diff === 0, endOffset: parsed.endOffset, contentLength, diff };
+};
+
+/** Pick `want` segments evenly spread over the track (the first one always). */
+export const pickEvenly = (refs: SidxRef[], want: number): number[] => {
+  const n = refs.length;
+  if (!n) return [];
+  if (n <= want) return refs.map((r) => r.index);
+  if (want <= 1) return [0];
+
+  const out: number[] = [];
+  for (let i = 0; i < want; i += 1) {
+    out.push(Math.round((i * (n - 1)) / (want - 1)));
+  }
+  return Array.from(new Set(out)).sort((a, b) => a - b);
+};
+
+/**
+ * Pick `k` entries out of an already evenly spread list, keeping both ends.
+ * Used for the progressive first batch so it still covers 0%-100% of the
+ * timeline instead of just the first few seconds.
+ */
+export const pickCoarse = (picks: number[], k: number): number[] => {
+  const n = picks.length;
+  if (!n || k <= 0) return [];
+  if (k >= n) return picks.slice();
+
+  const out: number[] = [];
+  for (let i = 0; i < k; i += 1) {
+    out.push(picks[Math.round((i * (n - 1)) / (k - 1))]);
+  }
+  return Array.from(new Set(out)).sort((a, b) => a - b);
+};
+
+export default {
+  readBoxHeader,
+  findBox,
+  startsWithBox,
+  parseSidx,
+  verifySidx,
+  pickEvenly,
+  pickCoarse,
+};
