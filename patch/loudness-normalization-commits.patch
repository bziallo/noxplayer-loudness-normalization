 2 files changed, 41 insertions(+)
 create mode 100644 src/components/buttons/BiliVideoButton.tsx

diff --git a/src/components/App/ExtendContent.tsx b/src/components/App/ExtendContent.tsx
index dd45d5f..72ce126 100644
--- a/src/components/App/ExtendContent.tsx
