@@ -0,0 +1,281 @@
+/* ================================================================
+ * loudnessEngine.ts — where the fixed gain is applied.
+ *
+ * Ported (and trimmed to a single, single-instance <audio> element) from
+ * Bilibili_LoudNorm/src/audio-engine.js (MIT, (c) 2026 Moxia9527).
+ *
+ *     <audio> -> MediaElementSource -> normGain -> destination
+ *
+ * Notes:
+ *   - The element keeps its own `volume` (the player's slider): per the Web
+ *     Audio spec the media element "MUST behave in an identical fashion" once
+ *     a MediaElementAudioSourceNode exists, so volume and our gain multiply.
+ *     That is exactly why the gain must live in a GainNode instead of being
+ *     written into `volume`: it no longer fights the slider or the saved
+ *     default volume.
+ *   - Three hard rules, learned from the userscript's bug reports:
+ *       1. never disconnect a node (it silences the element forever),
+ *       2. never call play()/pause()/preventDefault(),
+ *       3. never take the element over while the AudioContext is not running
+ *          (the audio would be routed into a suspended graph == silence).
+ *   - The gain is a single constant per track (plus a 120ms smoothing ramp on
+ *     change). No compression, no limiting, dynamic range untouched.
+ * ================================================================ */
+import { logger } from '@utils/Logger';
+
+import { GAIN_RAMP_TAU } from './config';
+import { dbToLinear } from './gainPlanner';
+import { LoudnessApplicationMode } from './types';
+
+let ctx: AudioContext | null = null;
+let normGain: GainNode | null = null;
+
+/** elements already taken over (createMediaElementSource may only run once) */
+const attached = new WeakSet<HTMLAudioElement>();
+/** elements that threw; never retried, so we do not spam the console */
+const failed = new WeakSet<HTMLAudioElement>();
+
+let desiredGainDb = 0;
+let appliedGainDb = 0;
+let bypass = false;
+let mode: LoudnessApplicationMode = 'off';
+
+/* ------------------------------------------------------ volume fallback */
+
+let volumeElement: HTMLAudioElement | null = null;
+/** the player's own volume, i.e. the value the slider asked for */
+let baseVolume = 1;
+let volumeAppliedDb = 0;
+/** true while our own `volume` write is in flight, so we can ignore it */
+let writingVolume = false;
+let volumeResetTimer: ReturnType<typeof setTimeout> | null = null;
+
+const ensureContext = () => {
+  if (ctx) return ctx;
+  const Ctor = globalThis.AudioContext;
+  if (!Ctor) {
+    logger.notice(
+      '[loudness] AudioContext is unavailable; keeping original audio',
+    );
+    return null;
+  }
+  try {
+    ctx = new Ctor();
+    normGain = ctx.createGain();
+    normGain.gain.value = 1;
+    normGain.connect(ctx.destination);
+    logger.info(
+      `[loudness] AudioContext ready (${ctx.sampleRate}Hz, state=${ctx.state})`,
+    );
+  } catch (e) {
+    logger.notice(`[loudness] AudioContext creation failed: ${e}`);
+    ctx = null;
+    normGain = null;
+  }
+  return ctx;
+};
+
+/**
+ * Take the element over with a GainNode.
+ * Returns false when the caller should fall back (never throws, never
+ * interrupts playback).
+ */
+export const attach = async (el: HTMLAudioElement): Promise<boolean> => {
+  if (attached.has(el)) return true;
+  if (failed.has(el)) return false;
+
+  const context = ensureContext();
+  if (!context) return false;
+
+  if (context.state !== 'running') {
+    try {
+      await context.resume();
+    } catch (e) {
+      logger.debug(`[loudness] ctx.resume() rejected: ${e}`);
+    }
+  }
+  if (context.state !== 'running') {
+    // rule 3: routing into a suspended context would silence the player
+    logger.notice(
+      `[loudness] AudioContext is ${context.state}; not taking over yet`,
+    );
+    return false;
+  }
+
+  try {
+    const source = context.createMediaElementSource(el);
+    source.connect(normGain as GainNode);
+    attached.add(el);
+    leaveVolumeMode(el);
+    mode = 'gain-node';
+    applyGain({ immediate: true });
+    logger.info(
+      '[loudness] <audio> is now routed through the loudness gain node',
+    );
+    return true;
+  } catch (e) {
+    failed.add(el);
+    logger.notice(
+      `[loudness] createMediaElementSource failed (${
+        (e as Error)?.name ?? 'unknown'
+      }); keeping original audio`,
+    );
+    return false;
+  }
+};
+
+/* ------------------------------------------------------ volume fallback */
+
+const onVolumeChange = () => {
+  const el = volumeElement;
+  if (!el) return;
+  if (writingVolume) {
+    writingVolume = false;
+    return;
+  }
+  // the player (or the user) changed the volume: treat it as the new base and
+  // re-apply our attenuation on top of it
+  const currentLinear = dbToLinear(volumeAppliedDb);
+  baseVolume = currentLinear > 0 ? el.volume / currentLinear : el.volume;
+  applyVolumeGain(volumeAppliedDb);
+};
+
+const applyVolumeGain = (db: number) => {
+  const el = volumeElement;
+  if (!el) return false;
+  // element volume cannot boost (max 1.0), so attenuation only
+  const limitedDb = Math.min(0, db);
+  const target = Math.max(0, Math.min(1, baseVolume * dbToLinear(limitedDb)));
+
+  writingVolume = true;
+  if (volumeResetTimer) clearTimeout(volumeResetTimer);
+  volumeResetTimer = setTimeout(() => {
+    writingVolume = false;
+  }, 300);
+
+  try {
+    el.volume = target;
+  } catch (e) {
+    logger.notice(`[loudness] volume fallback write failed: ${e}`);
+    return false;
+  }
+  volumeAppliedDb = limitedDb;
+  appliedGainDb = limitedDb;
+  return true;
+};
+
+/**
+ * Fallback used when the GainNode is unavailable: attenuate with `volume`.
+ * Boost is impossible here, so the plan is clamped to <= 0dB.
+ */
+export const enterVolumeMode = (el: HTMLAudioElement) => {
+  if (mode === 'gain-node') return;
+  if (volumeElement === el) return;
+  mode = 'volume';
+  volumeElement = el;
+  baseVolume = el.volume > 0 ? el.volume : 1;
+  el.addEventListener('volumechange', onVolumeChange);
+  applyVolumeGain(desiredGainDb);
+  logger.notice(
+    '[loudness] falling back to element volume: attenuation only, no boost',
+  );
+};
+
+/** true while our own volume write is in flight (used to avoid persisting it
+ * as the user's default volume) */
+export const isWritingVolume = () => writingVolume;
+
+/**
+ * Undo the volume fallback once the GainNode took over: put the player's own
+ * volume back and stop listening to volumechange.
+ */
+const leaveVolumeMode = (el: HTMLAudioElement) => {
+  if (volumeElement !== el) return;
+  el.removeEventListener('volumechange', onVolumeChange);
+  try {
+    if (volumeAppliedDb !== 0) el.volume = Math.max(0, Math.min(1, baseVolume));
+  } catch (e) {
+    logger.debug(`[loudness] restoring volume failed: ${e}`);
+  }
+  volumeElement = null;
+  volumeAppliedDb = 0;
+  writingVolume = false;
+  if (volumeResetTimer) {
+    clearTimeout(volumeResetTimer);
+    volumeResetTimer = null;
+  }
+};
+
+/* -------------------------------------------------------------- gain */
+
+const applyGain = (opts?: { immediate?: boolean }) => {
+  const target = bypass ? 0 : desiredGainDb;
+
+  if (mode === 'volume') return applyVolumeGain(target);
+
+  if (!ctx || !normGain) return false;
+  const linear = dbToLinear(target);
+  const ramp = !(opts?.immediate === true);
+
+  try {
+    if (ramp && ctx.state === 'running') {
+      const now = ctx.currentTime;
+      const current = normGain.gain.value;
+      normGain.gain.cancelScheduledValues(now);
+      normGain.gain.setValueAtTime(current, now);
+      normGain.gain.setTargetAtTime(linear, now, GAIN_RAMP_TAU);
+    } else {
+      normGain.gain.value = linear;
+    }
+    appliedGainDb = target;
+    logger.debug(
+      `[loudness] gain ${target >= 0 ? '+' : ''}${target.toFixed(2)}dB ` +
+        `(${ramp ? 'ramp' : 'immediate'}${bypass ? ', bypassed' : ''})`,
+    );
+    return true;
+  } catch (e) {
+    logger.notice(`[loudness] setting gain failed: ${e}`);
+    return false;
+  }
+};
+
+/** Set the target gain (dB). Safe to call at any time. */
+export const setGainDb = (db: number, opts?: { immediate?: boolean }) => {
+  if (!Number.isFinite(db)) return false;
+  desiredGainDb = db;
+  return applyGain(opts);
+};
+
+/** A/B switch: keep the measurement, output the original audio. */
+export const setBypass = (v: boolean) => {
+  const next = !!v;
+  if (next === bypass) return bypass;
+  bypass = next;
+  applyGain();
+  logger.info(
+    `[loudness] bypass ${bypass ? 'on' : 'off'} ` +
+      `(normalization remembers ${desiredGainDb.toFixed(2)}dB)`,
+  );
+  return bypass;
+};
+
+export const getBypass = () => bypass;
+export const getMode = () => mode;
+export const getAppliedGainDb = () => appliedGainDb;
+export const getDesiredGainDb = () => desiredGainDb;
+export const getGainValue = () => (normGain ? normGain.gain.value : null);
+export const getContextState = () => (ctx ? ctx.state : null);
+
+export default {
+  attach,
+  enterVolumeMode,
+  setGainDb,
+  setBypass,
+  getBypass,
+  getMode,
+  getAppliedGainDb,
+  getDesiredGainDb,
+  getGainValue,
+  getContextState,
+  isWritingVolume,
+};
