@@ -0,0 +1,61 @@
+/* ================================================================
+ * ffmpegEngine.ts — whole file measurement via ffmpeg.wasm (ReplayGain 2.0).
+ *
+ * This is the legacy nox-player path, kept as a fallback (and as an explicit
+ * user choice) for sources where the sidx sampler does not apply.
+ *
+ * It downloads and decodes the *entire* stream, so it is much more expensive
+ * than sampling: a 110 minute video's audio is ~54MB and takes tens of
+ * seconds. Values are normalized into the same units as the sampler, so both
+ * engines feed one cache and one gain planner.
+ * ================================================================ */
+import { logger } from '@utils/Logger';
+
+import { REPLAYGAIN_REFERENCE_LUFS } from './config';
+import { LoudnessMeasurement } from './types';
+
+/**
+ * ReplayGain 2.0 gain is defined against a -18 LUFS reference, so
+ * `measured = reference - gain` turns ffmpeg's number into LUFS.
+ */
+export const replayGainToMeasurement = (
+  trackGainDb: number,
+  trackPeakLinear: number | null,
+  elapsedMs = 0,
+): LoudnessMeasurement => ({
+  measuredLufs: Number((REPLAYGAIN_REFERENCE_LUFS - trackGainDb).toFixed(2)),
+  truePeakDb:
+    trackPeakLinear && trackPeakLinear > 0
+      ? Number((20 * Math.log10(trackPeakLinear)).toFixed(2))
+      : null,
+  engine: 'ffmpeg',
+  segments: 0,
+  elapsedMs,
+});
+
+export const measureStreamLoudnessWithFFmpeg = async (
+  url: string,
+): Promise<LoudnessMeasurement> => {
+  const started = Date.now();
+  // Dynamic import: ffmpeg.wasm is large and loads at import time, so it must
+  // not be pulled in unless this engine is actually used.
+  const { measureReplayGain } = await import('@utils/ffmpeg/ffmpeg');
+  const { trackGainDb, trackPeakLinear } = await measureReplayGain(url);
+
+  if (trackGainDb === null || !Number.isFinite(trackGainDb)) {
+    throw new Error('ffmpeg replaygain produced no track_gain');
+  }
+
+  const measurement = replayGainToMeasurement(
+    trackGainDb,
+    trackPeakLinear,
+    Date.now() - started,
+  );
+  logger.debug(
+    `[loudness] ffmpeg replaygain ${trackGainDb}dB / peak ${trackPeakLinear} ` +
+      `-> ${measurement.measuredLufs} LUFS in ${measurement.elapsedMs}ms`,
+  );
+  return measurement;
+};
+
+export default { measureStreamLoudnessWithFFmpeg, replayGainToMeasurement };
