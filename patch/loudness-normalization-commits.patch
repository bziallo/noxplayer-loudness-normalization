@@ -0,0 +1,85 @@
+/* ================================================================
+ * biliAudioFailover.ts — retry a stalled B站 audio stream on another mirror.
+ *
+ * Every B站 audio stream comes with `baseUrl` plus one or two `backupUrl`
+ * mirrors on different CDNs, but the shared resolver only keeps `baseUrl`
+ * (@APM/utils/mediafetch/bilivideo). When that one host is unreachable —
+ * `ERR_CONNECTION_TIMED_OUT`, which shows up as
+ * "[RJKM] format error encountered; this could indicate network errors" —
+ * the track would otherwise never play.
+ *
+ * So: on an audio error we ask playurl once more and walk the mirrors.
+ * ================================================================ */
+import { wbiQuery } from '@APM/stores/wbi';
+import { logger } from '@utils/Logger';
+
+/** same endpoint the shared resolver uses */
+const PLAYURL =
+  'https://api.bilibili.com/x/player/wbi/playurl?cid={cid}&bvid={bvid}&qn=64&fnval=16&try_look=1&voice_balance=1';
+
+/** the original URL plus at most this many mirror retries, then give up */
+export const MAX_MIRROR_ATTEMPTS = 3;
+
+const mirrorCache = new Map<string, string[]>();
+const attemptCount = new Map<string, number>();
+
+const bestByBandwidth = (list?: { bandwidth?: number }[]) =>
+  (list ?? [])
+    .slice()
+    .sort((a, b) => (b.bandwidth ?? 0) - (a.bandwidth ?? 0))[0];
+
+const pickAudio = (data: any) =>
+  bestByBandwidth(data?.dash?.flac?.audio) ??
+  bestByBandwidth(data?.dash?.dolby?.audio) ??
+  bestByBandwidth(data?.dash?.audio);
+
+/** Resolve (and cache) every playable URL for a B站 track, best first. */
+export const resolveMirrors = async (
+  song: NoxMedia.Song,
+): Promise<string[]> => {
+  const cached = mirrorCache.get(song.id);
+  if (cached) return cached;
+  // only B站 video tracks carry a bvid/playurl
+  if (!song.bvid || !song.bvid.startsWith('BV')) return [];
+
+  const res = await wbiQuery(
+    PLAYURL.replace('{bvid}', song.bvid).replace('{cid}', String(song.id)),
+    { method: 'GET', headers: {}, credentials: 'omit' },
+  );
+  const json = await res.json();
+  const audio = pickAudio(json?.data) as
+    { baseUrl?: string; backupUrl?: string[] } | undefined;
+  const urls = [audio?.baseUrl, ...(audio?.backupUrl ?? [])].filter(
+    (url): url is string => typeof url === 'string' && url.length > 0,
+  );
+  const unique = Array.from(new Set(urls));
+  mirrorCache.set(song.id, unique);
+  logger.debug(`[failover] ${song.bvid}: ${unique.length} 个可用地址`);
+  return unique;
+};
+
+/** The next mirror worth trying, skipping the URL that just failed. */
+export const nextMirror = (
+  song: NoxMedia.Song,
+  failedUrl?: string,
+): string | undefined => {
+  const list = mirrorCache.get(song.id) ?? [];
+  let tried = attemptCount.get(song.id) ?? 0;
+  while (tried < list.length && tried < MAX_MIRROR_ATTEMPTS) {
+    const candidate = list[tried];
+    tried += 1;
+    attemptCount.set(song.id, tried);
+    if (candidate !== failedUrl) return candidate;
+  }
+  return undefined;
+};
+
+/** Forget cached mirrors/attempts, e.g. when the track is played again. */
+export const resetMirrors = (songId: string) => {
+  mirrorCache.delete(songId);
+  attemptCount.delete(songId);
+};
+
+export const triedMirrors = (songId: string) => attemptCount.get(songId) ?? 0;
+
+export default { resolveMirrors, nextMirror, resetMirrors, triedMirrors };
-- 
