@@ -0,0 +1,100 @@
+/* ================================================================
+ * gainPlanner.ts — loudness to gain (pure calculation).
+ *
+ * Ported from Bilibili_LoudNorm/src/gain-planner.js (MIT, (c) 2026 Moxia9527).
+ *
+ *   gain_dB = target loudness - measured loudness
+ *
+ * then constrained by:
+ *   1. clipping budget (limits boosts only, never forces attenuation)
+ *   2. profile.maxBoostDb
+ *   3. profile.minGainDb
+ *
+ * Note on (1): the naive form `clamp(gain, -INF, peakCeiling - truePeak)`
+ * treats the clipping budget as a "max gain", so already-clipped material
+ * (true peak > 0 dBTP is common in loudness-compressed sources) gets pushed
+ * *below* its original level - the quieter it is, the less it should be
+ * boosted, but it ends up attenuated. Measured counter example from the
+ * userscript's test suite: -18.69 LUFS / +0.79 dBTP should gain +4.69dB, the
+ * naive form gives -1.79dB and lands 1.8dB below the original. So the headroom
+ * is clamped at 0: no boost when there is no room, and never a penalty.
+ * ================================================================ */
+import { PEAK_CEILING_DB } from './config';
+import { GainPlan, GainProfile } from './types';
+
+export interface GainPlannerInput {
+  measuredLufs?: number | null;
+  truePeakDb?: number | null;
+}
+
+export const planGain = (
+  input: GainPlannerInput,
+  profile: GainProfile,
+): GainPlan => {
+  const targetLufs = profile.targetLufs;
+  const measured = input?.measuredLufs;
+
+  if (!Number.isFinite(measured)) {
+    return {
+      gainDb: 0,
+      targetLufs,
+      rawGainDb: null,
+      limited: false,
+      limitReason: 'no-measurement',
+      ceilingHeadroom: null,
+      profileKey: profile.key,
+    };
+  }
+
+  const rawGainDb = targetLufs - (measured as number);
+  let gainDb = rawGainDb;
+  let limited = false;
+  let limitReason: string | null = null;
+  let ceilingHeadroom: number | null = null;
+
+  const tp = input.truePeakDb;
+  if (Number.isFinite(tp)) {
+    ceilingHeadroom = PEAK_CEILING_DB - (tp as number);
+
+    // only the boost side is clamped; attenuation is always allowed
+    const maxAllowedGain = Math.max(0, ceilingHeadroom);
+    if (rawGainDb > maxAllowedGain) {
+      gainDb = maxAllowedGain;
+      limited = true;
+      limitReason =
+        ceilingHeadroom < 0
+          ? '+0 dB (source already clips)'
+          : `+${ceilingHeadroom.toFixed(1)} dB (anti clipping)`;
+    }
+  }
+
+  const cap = Number.isFinite(profile.maxBoostDb) ? profile.maxBoostDb : 12;
+  if (gainDb > cap) {
+    gainDb = cap;
+    limited = true;
+    limitReason = `profile cap +${cap} dB`;
+  }
+
+  const floor = Number.isFinite(profile.minGainDb) ? profile.minGainDb : -60;
+  if (gainDb < floor) {
+    gainDb = floor;
+    limited = true;
+    limitReason = `profile floor ${floor} dB`;
+  }
+
+  return {
+    gainDb: Number(gainDb.toFixed(2)),
+    targetLufs,
+    rawGainDb: Number(rawGainDb.toFixed(2)),
+    limited,
+    limitReason,
+    ceilingHeadroom:
+      ceilingHeadroom === null ? null : Number(ceilingHeadroom.toFixed(2)),
+    profileKey: profile.key,
+  };
+};
+
+/** linear amplitude for a dB gain */
+export const dbToLinear = (db: number) => 10 ** (db / 20);
+
+export default { planGain, dbToLinear };
