+++ b/src/components/setting/LoudnessSetting.tsx
@@ -0,0 +1,215 @@
+/* ================================================================
+ * LoudnessSetting.tsx — settings panel for whole-track loudness normalization.
+ *
+ * Mirrors the userscript's panel: preset "loudness tables" plus sliders for
+ * target loudness / max boost / max attenuation, an A/B bypass switch and a
+ * cache reset.
+ * ================================================================ */
+import React, { useEffect, useState } from 'react';
+import Box from '@mui/material/Box';
+import Button from '@mui/material/Button';
+import Checkbox from '@mui/material/Checkbox';
+import Divider from '@mui/material/Divider';
+import FormControl from '@mui/material/FormControl';
+import FormControlLabel from '@mui/material/FormControlLabel';
+import InputLabel from '@mui/material/InputLabel';
+import MenuItem from '@mui/material/MenuItem';
+import Select from '@mui/material/Select';
+import Slider from '@mui/material/Slider';
+import Tooltip from '@mui/material/Tooltip';
+import Typography from '@mui/material/Typography';
+
+import { useNoxSetting } from '@APM/stores/useApp';
+import {
+  CUSTOM_PROFILE_KEY,
+  DEFAULT_PROFILES,
+  MAX_BOOST_RANGE,
+  MIN_GAIN_RANGE,
+  TARGET_RANGE,
+} from '@utils/audio/loudness/config';
+import {
+  clearLoudnessCache,
+  resolveLoudnessSetting,
+  subscribeStatus,
+} from '@utils/audio/loudness/normalizeClient';
+import { LoudnessStatus } from '@utils/audio/loudness/types';
+
+const STAGE_LABEL: Record<LoudnessStatus['stage'], string> = {
+  idle: '待机',
+  'cache-hit': '命中缓存',
+  measuring: '测量中',
+  applied: '已施加固定增益',
+  failed: '测量失败（原声）',
+  skipped: '未启用',
+};
+
+export default function LoudnessSetting() {
+  const playerSetting = useNoxSetting((state) => state.playerSetting);
+  const setPlayerSetting = useNoxSetting((state) => state.setPlayerSetting);
+  const [status, setStatus] = useState<LoudnessStatus>();
+
+  useEffect(() => subscribeStatus(setStatus), []);
+
+  const setting = resolveLoudnessSetting(playerSetting);
+  const isCustom = playerSetting.loudnessProfile === CUSTOM_PROFILE_KEY;
+  const fmt = (v?: number, unit = '') =>
+    v === undefined || v === null ? '—' : `${v}${unit}`;
+
+  return (
+    <Box sx={{ mt: 1, mb: 1 }}>
+      <Divider sx={{ mb: 1 }} />
+      <FormControlLabel
+        control={
+          <Checkbox
+            checked={playerSetting.loudnessNormalize === true}
+            onChange={(e) =>
+              setPlayerSetting({ loudnessNormalize: e.target.checked })
+            }
+          />
+        }
+        label='响度归一（整段测量 + 固定增益）'
+      />
+      <Typography variant='caption' color='text.secondary'>
+        先量完整首/整段的集成响度，再对这一个视频施加一个常数增益；
+        不做实时压缩，动态范围原样保留。首次播放要等一小会儿，之后走缓存。
+      </Typography>
+
+      <Box sx={{ display: 'flex', gap: 2, flexWrap: 'wrap', mt: 1 }}>
+        <FormControl size='small' sx={{ minWidth: 160 }}>
+          <InputLabel id='loudness-profile-label'>响度档案</InputLabel>
+          <Select
+            labelId='loudness-profile-label'
+            label='响度档案'
+            value={playerSetting.loudnessProfile ?? DEFAULT_PROFILES[0].key}
+            onChange={(e) =>
+              setPlayerSetting({ loudnessProfile: e.target.value })
+            }
+          >
+            {DEFAULT_PROFILES.map((p) => (
+              <MenuItem key={p.key} value={p.key}>
+                {p.label}（{p.targetLufs} LUFS）
+              </MenuItem>
+            ))}
+          </Select>
+        </FormControl>
+
+        <FormControl size='small' sx={{ minWidth: 200 }}>
+          <InputLabel id='loudness-engine-label'>测量方式</InputLabel>
+          <Select
+            labelId='loudness-engine-label'
+            label='测量方式'
+            value={playerSetting.loudnessEngine ?? 'auto'}
+            onChange={(e) =>
+              setPlayerSetting({
+                loudnessEngine: e.target.value as 'auto' | 'sidx' | 'ffmpeg',
+              })
+            }
+          >
+            <MenuItem value='auto'>自动（B站抽样 / 其它 ffmpeg）</MenuItem>
+            <MenuItem value='sidx'>抽样测量（快，约 0.5MB）</MenuItem>
+            <MenuItem value='ffmpeg'>ffmpeg 全片（慢，最准）</MenuItem>
+          </Select>
+        </FormControl>
+      </Box>
+
+      <Box sx={{ mt: 1, px: 1 }}>
+        <Tooltip title='拖动后自动切到「自定义」档案'>
+          <Typography variant='body2'>
+            目标响度 {isCustom ? '（自定义）' : ''}：
+            {setting.profile.targetLufs} LUFS
+          </Typography>
+        </Tooltip>
+        <Slider
+          size='small'
+          min={TARGET_RANGE[0]}
+          max={TARGET_RANGE[1]}
+          step={0.5}
+          value={playerSetting.loudnessTargetLufs ?? setting.profile.targetLufs}
+          onChange={(_e, v) =>
+            setPlayerSetting({
+              loudnessProfile: CUSTOM_PROFILE_KEY,
+              loudnessTargetLufs: v as number,
+            })
+          }
+        />
+        <Typography variant='body2'>
+          最大提升：{setting.profile.maxBoostDb} dB（受真峰值 ≤ -1 dBTP 约束）
+        </Typography>
+        <Slider
+          size='small'
+          min={MAX_BOOST_RANGE[0]}
+          max={MAX_BOOST_RANGE[1]}
+          step={1}
+          value={playerSetting.loudnessMaxBoostDb ?? setting.profile.maxBoostDb}
+          onChange={(_e, v) =>
+            setPlayerSetting({
+              loudnessProfile: CUSTOM_PROFILE_KEY,
+              loudnessMaxBoostDb: v as number,
+            })
+          }
+        />
+        <Typography variant='body2'>
+          最大衰减：{setting.profile.minGainDb} dB
+        </Typography>
+        <Slider
+          size='small'
+          min={MIN_GAIN_RANGE[0]}
+          max={MIN_GAIN_RANGE[1]}
+          step={1}
+          value={playerSetting.loudnessMinGainDb ?? setting.profile.minGainDb}
+          onChange={(_e, v) =>
+            setPlayerSetting({
+              loudnessProfile: CUSTOM_PROFILE_KEY,
+              loudnessMinGainDb: v as number,
+            })
+          }
+        />
+      </Box>
+
+      <FormControlLabel
+        control={
+          <Checkbox
+            checked={playerSetting.loudnessPrefetchNext !== false}
+            onChange={(e) =>
+              setPlayerSetting({ loudnessPrefetchNext: e.target.checked })
+            }
+          />
+        }
+        label='提前测量下一首（切歌更平滑）'
+      />
+      <FormControlLabel
+        control={
+          <Checkbox
+            checked={playerSetting.loudnessBypass === true}
+            onChange={(e) =>
+              setPlayerSetting({ loudnessBypass: e.target.checked })
+            }
+          />
+        }
+        label='旁路（听原声做 A/B 对比）'
+      />
+
+      <Box sx={{ display: 'flex', alignItems: 'center', gap: 2, mt: 1 }}>
+        <Button
+          size='small'
+          variant='outlined'
+          onClick={() => clearLoudnessCache()}
+        >
+          清空测量缓存
+        </Button>
+        <Typography variant='caption' color='text.secondary'>
+          {status
+            ? `${STAGE_LABEL[status.stage]} · ${
+                status.engine ?? '—'
+              } · 实测 ${fmt(status.measuredLufs, ' LUFS')} · 目标 ${fmt(
+                status.targetLufs,
+                ' LUFS',
+              )} · 增益 ${fmt(status.gainDb, ' dB')} · 输出 ${status.mode}${
+                status.reason ? ` · ${status.reason}` : ''
+              }`
+            : '尚无测量记录'}
+        </Typography>
+      </Box>
+    </Box>
+  );
+}
