index 0000000..2a4b1e5
--- /dev/null
+++ b/src/NoxTypes/loudness.d.ts
@@ -0,0 +1,25 @@
+/**
+ * Settings for whole-track loudness normalization (measure the track, then
+ * apply one fixed gain). All keys are optional so that the shared defaults in
+ * azusa-player-mobile keep compiling.
+ */
+declare namespace NoxStorage {
+  export interface PlayerSettingDict {
+    /** master switch */
+    loudnessNormalize?: boolean;
+    /** one of the preset keys in utils/audio/loudness/config.ts */
+    loudnessProfile?: string;
+    /** target loudness used by the `custom` profile (LUFS) */
+    loudnessTargetLufs?: number;
+    /** max boost for the `custom` profile (dB) */
+    loudnessMaxBoostDb?: number;
+    /** how far the `custom` profile may attenuate (dB) */
+    loudnessMinGainDb?: number;
+    /** measurement backend: `auto` = sampled for B站, ffmpeg otherwise */
+    loudnessEngine?: 'auto' | 'sidx' | 'ffmpeg';
+    /** A/B switch: keep measuring, output the original audio */
+    loudnessBypass?: boolean;
+    /** measure the next track in the queue while this one plays */
+    loudnessPrefetchNext?: boolean;
+  }
+}
