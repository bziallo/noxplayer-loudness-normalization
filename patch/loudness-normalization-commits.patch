+/* ================================================================
+ * Loudness normalization: shared types.
+ *
+ * The measurement math in this folder is a TypeScript port of
+ * Bilibili_LoudNorm (https://github.com/ADMA200/Bilibili_LoudNorm),
+ * MIT licensed, (c) 2026 Moxia9527. See THIRD-PARTY notices below.
+ *
+ * Design notes:
+ *   - `measuredLufs` (a property of the *track*) is cached, never the gain:
+ *     gain = profile.targetLufs - measuredLufs, so switching a profile
+ *     never needs a re-measurement.
+ *   - Everything here is a pure function of PCM data + config, which makes
+ *     the whole pipeline unit-testable outside of a browser.
+ * ================================================================ */
+
+/** Which backend produced a measurement. */
+export type LoudnessEngineKind = 'sidx' | 'ffmpeg';
+
+/** User selectable measurement strategy. */
+export type LoudnessEngineOption = 'auto' | 'sidx' | 'ffmpeg';
+
+/** One fMP4 subsegment taken from the sidx index. */
+export interface SidxRef {
+  /** index inside the sidx reference list */
+  index: number;
+  /** start time in seconds */
+  t: number;
+  /** duration in seconds */
+  duration: number;
+  /** byte size of the referenced media segment */
+  size: number;
+  /** absolute byte offset inside the media file */
+  offset: number;
+}
+
+/** Parsed sidx box (ISO/IEC 14496-12 8.16.3). */
+export interface ParsedSidx {
+  version: number;
+  timescale: number;
+  earliestPresentationTime: number;
+  firstOffset: number;
+  /** byte offset the `firstOffset` field is relative to (end of the sidx box) */
+  anchor: number;
+  refs: SidxRef[];
+  /** anchor + firstOffset + sum(refs.size): must equal Content-Length */
+  endOffset: number;
+}
+
+/** Raw decoded PCM: one Float32Array per channel. */
+export interface PcmChannels {
+  channels: Float32Array[];
+  sampleRate: number;
+}
+
+/** BS.1770-4 integrated loudness + true peak. */
+export interface LoudnessCore {
+  /** integrated loudness (LUFS), null when every block was gated out */
+  lufs: number | null;
+  /** true peak estimate (dBTP) */
+  truePeakDb: number;
+  blocks: number;
+  blocksAfterAbsGate: number;
+  blocksAfterRelGate: number;
+  frames: number;
+  sampleRate: number;
+  channels: number;
+}
+
+/** A cached, track level measurement. */
+export interface LoudnessMeasurement {
+  measuredLufs: number;
+  /** null when the backend could not report a peak (then no clipping budget) */
+  truePeakDb: number | null;
+  engine: LoudnessEngineKind;
+  /** how many sampled segments contributed (1 for ffmpeg, 0 when unknown) */
+  segments: number;
+  elapsedMs: number;
