@@ -0,0 +1,144 @@
+/* ================================================================
+ * config.ts — constants and preset profiles for loudness normalization.
+ *
+ * Defaults mirror the userscript's tuned values (Bilibili_LoudNorm, MIT,
+ * (c) 2026 Moxia9527) so the measured loudness matches its panel.
+ * ================================================================ */
+import { GainProfile } from './types';
+
+/** Bump when the measurement math changes; stale cache rows are ignored. */
+export const LOUDNESS_ENGINE_VERSION = 1;
+
+/**
+ * Boost ceiling: gain is only raised while the real true peak stays at or
+ * below this value. Attenuation is never limited by the ceiling, because
+ * lowering the gain can only lower peaks.
+ */
+export const PEAK_CEILING_DB = -1.0;
+
+/** setTargetAtTime time constant (seconds); 3 tau is about 120ms. */
+export const GAIN_RAMP_TAU = 0.04;
+
+/** Sample rate used to decode the sampled fragments (B站 audio is 48kHz). */
+export const DECODE_SAMPLE_RATE = 48000;
+
+/* ---------------------------------------------------- preset profiles
+ * `custom` is written by the settings sliders. Standard == -14 LUFS so that
+ * content B站 already normalized ends up with ~0dB of gain. */
+export const CUSTOM_PROFILE_KEY = 'custom';
+
+export const DEFAULT_PROFILES: GainProfile[] = [
+  {
+    key: 'standard',
+    label: '标准',
+    targetLufs: -14,
+    maxBoostDb: 12,
+    minGainDb: -60,
+  },
+  {
+    key: 'dynamic',
+    label: '高动态',
+    targetLufs: -24,
+    maxBoostDb: 12,
+    minGainDb: -60,
+  },
+  {
+    key: 'headphone',
+    label: '耳机',
+    targetLufs: -16,
+    maxBoostDb: 12,
+    minGainDb: -60,
+  },
+  {
+    key: 'speaker',
+    label: '外放',
+    targetLufs: -11,
+    maxBoostDb: 10,
+    minGainDb: -60,
+  },
+  {
+    key: 'night',
+    label: '深夜',
+    targetLufs: -20,
+    maxBoostDb: 6,
+    minGainDb: -60,
+  },
+  {
+    key: CUSTOM_PROFILE_KEY,
+    label: '自定义',
+    targetLufs: -14,
+    maxBoostDb: 12,
+    minGainDb: -24,
+  },
+];
+
+export const DEFAULT_PROFILE_KEY = 'standard';
+
+/** Slider ranges, same as the userscript's settings panel. */
+export const TARGET_RANGE: [number, number] = [-28, -8];
+export const MAX_BOOST_RANGE: [number, number] = [0, 18];
+export const MIN_GAIN_RANGE: [number, number] = [-60, 0];
+
+/* -------------------------------------------------- sampling budget
+ * Costs: 12 segments of ~5s == ~60s of audio == ~0.5MB, i.e. <1% of a long
+ * video and ~20% of a short song. `progressive` makes the first result
+ * available after `FIRST_BATCH_EAGER_AT` segments while the rest streams in. */
+export const SAMPLE_SEGMENTS = 12;
+export const FIRST_BATCH_SEGMENTS = 6;
+export const FIRST_BATCH_EAGER_AT = 4;
+/** Only re-apply when the refined gain differs by more than this. */
+export const REFINE_MIN_DELTA_DB = 0.5;
+export const SEGMENT_CONCURRENCY = 6;
+export const REQUEST_GAP_MS = 80;
+/** First Range request: covers ftyp+moov+sidx of most files in one shot. */
+export const HEAD_WINDOW_BYTES = 32768;
+export const FETCH_TIMEOUT_MS = 15000;
+export const SEGMENT_TIMEOUT_MS = 5000;
+export const SEGMENT_RETRY = 1;
+export const SEGMENT_RETRY_DELAY_MS = 250;
+/** Below this, admit that the network is too flaky and keep the original audio. */
+export const MIN_SEGMENTS_TO_PROCEED = 3;
+/** Yield to the event loop every N frames so the UI never blocks. */
+export const LUM_CHUNK_FRAMES = 240000;
+
+/** Audio ids that decode unreliably (dolby / hi-res); excluded from sampling. */
+export const EXCLUDED_AUDIO_IDS = [30250, 30251];
+
+/** ReplayGain 2.0 reference loudness used by ffmpeg's `replaygain` filter. */
+export const REPLAYGAIN_REFERENCE_LUFS = -18;
+
+/**
+ * Hosts we are allowed to touch for sampling. They are the only hosts we set
+ * `crossOrigin='anonymous'` on, because they are the only ones we verified to
+ * answer with `Access-Control-Allow-Origin: *` (see the PR test notes).
+ */
+export const BILI_CDN_HOST_SUFFIXES = [
+  'bilivideo.com',
+  'bilivideo.cn',
+  'hdslb.com',
+  'cgvideo.com',
+  'acgvideo.com',
+];
+
+/** true when the URL points at a host we can sample (and may take over). */
+export const isBiliCdnUrl = (url?: string) => {
+  if (!url) return false;
+  try {
+    const { hostname } = new URL(url);
+    return BILI_CDN_HOST_SUFFIXES.some(
+      (suffix) => hostname === suffix || hostname.endsWith(`.${suffix}`),
+    );
+  } catch {
+    return false;
+  }
+};
+
+/** Profiles are a fixed table plus the live `custom` row from the settings. */
+export const getProfile = (
+  key: string | undefined,
+  overrides?: Partial<GainProfile>,
+): GainProfile => {
+  const found =
+    DEFAULT_PROFILES.find((p) => p.key === key) ?? DEFAULT_PROFILES[0];
+  return overrides ? { ...found, ...overrides } : found;
+};
