+import { integer, pgTable, varchar, real } from 'drizzle-orm/pg-core';
+
+/**
+ * Cached loudness measurements, one row per song (= per cid).
+ *
+ * What gets cached is a property of the *track* (its integrated loudness and
+ * true peak), never the gain:
+ *     gain_dB = profile.targetLufs - measuredLufs
+ * so changing the target loudness or the preset never needs a re-measurement.
+ *
+ * Deliberately kept out of `r128gain-table`: those values come from ffmpeg's
+ * ReplayGain 2.0 filter (-18 LUFS reference) and are synced with the mobile
+ * app, while these are BS.1770-4 measurements. Mixing the two would silently
+ * corrupt both.
+ */
+const table = pgTable('loudness-table', {
+  id: integer().primaryKey().generatedAlwaysAsIdentity(),
+  songcid: varchar({ length: 255 }).unique().notNull(),
+  measuredLufs: real(),
+  truePeakDb: real(),
+  engine: varchar({ length: 16 }),
+  engineVersion: integer(),
+  segments: integer(),
+  updatedAt: real(),
+});
+
+export default table;
