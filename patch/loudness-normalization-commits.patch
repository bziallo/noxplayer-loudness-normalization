+  await new Promise((r) => partial.server.close(r));
+}
+
+/* -------------------------------------------------------------- main */
+
+testSidx();
+await testBs1770();
+testGainPlanner();
+await testSampler();
+console.log(`\n${pass} passed, ${failed} failed`);
+if (failed) {
+  console.log('failed:', failures.join(' | '));
+  process.exitCode = 1;
+}
+fs.rmSync(OUT, { recursive: true, force: true });
