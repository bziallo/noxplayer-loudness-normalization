+  check('high pass response matches ITU-R BS.1770-4 (<0.02 dB)', maxHpf < 0.02, `max ${maxHpf.toFixed(4)} dB`);
+
+  const amp = 10 ** (-20 / 20);
+  const ch = sine(fs * 30, fs, 1000, amp);
