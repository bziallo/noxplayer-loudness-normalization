index 0000000..59e4793
--- /dev/null
+++ b/src/utils/audio/loudness/normalizeClient.ts
@@ -0,0 +1,427 @@
+/* ================================================================
+ * normalizeClient.ts — orchestration: cache -> measure -> plan -> apply.
+ *
+ * Flow per track:
+ *   1. resolveForPlayback() runs *synchronously* right before the player
+ *      assigns the new src, so a cached gain is already in place when the
+ *      first sample of the new track is heard (no volume jump on switch).
+ *   2. normalizeSong() measures in the background (never blocking playback)
+ *      and ramps to the final gain once the number is in.
+ *
+ * The gain is one constant per track; nothing here compresses or limits, so
+ * the internal dynamics of a track survive untouched.
+ * ================================================================ */
+import { logger } from '@utils/Logger';
+import {
+  clearStoredMeasurements,
+  getStoredMeasurement,
+  storeMeasurement,
+} from '@utils/db/loudnessStorage';
+
+import {
+  CUSTOM_PROFILE_KEY,
+  DEFAULT_PROFILE_KEY,
+  REFINE_MIN_DELTA_DB,
+  getProfile,
+  isBiliCdnUrl,
+} from './config';
+import { measureStreamLoudnessWithFFmpeg } from './ffmpegEngine';
+import { planGain } from './gainPlanner';
+import loudnessEngine from './loudnessEngine';
+import {
+  GainProfile,
+  GainPlan,
+  LoudnessEngineKind,
+  LoudnessEngineOption,
+  LoudnessMeasurement,
+  LoudnessStatus,
+} from './types';
+
+export interface LoudnessSetting {
+  enabled: boolean;
+  profile: GainProfile;
+  engine: LoudnessEngineOption;
+  bypass: boolean;
+  prefetchNext: boolean;
+}
+
+export interface NormalizeOptions {
+  song: NoxMedia.Song;
+  /** the already resolved stream url, when the caller has it */
+  url?: string;
+  /** lazy resolver, used by prefetch and the ffmpeg engine */
+  getSource?: () => Promise<NoxNetwork.ParsedNoxMediaURL>;
+  playerSetting?: Partial<NoxStorage.PlayerSettingDict>;
+  /** the <audio> element currently playing */
+  mediaElement?: HTMLAudioElement | null;
+  /** measure + cache only (next track prefetch): never touches the output */
+  prefetchOnly?: boolean;
+}
+
+/* ------------------------------------------------------------- settings */
+
+export const resolveLoudnessSetting = (
+  playerSetting?: Partial<NoxStorage.PlayerSettingDict>,
+): LoudnessSetting => {
+  const profileKey = playerSetting?.loudnessProfile ?? DEFAULT_PROFILE_KEY;
+  // the sliders only drive the `custom` row; presets keep their own numbers
+  const overrides: Partial<GainProfile> = {};
+  if (profileKey === CUSTOM_PROFILE_KEY) {
+    if (Number.isFinite(playerSetting?.loudnessTargetLufs)) {
+      overrides.targetLufs = playerSetting?.loudnessTargetLufs;
+    }
+    if (Number.isFinite(playerSetting?.loudnessMaxBoostDb)) {
+      overrides.maxBoostDb = playerSetting?.loudnessMaxBoostDb;
+    }
+    if (Number.isFinite(playerSetting?.loudnessMinGainDb)) {
+      overrides.minGainDb = playerSetting?.loudnessMinGainDb;
+    }
+  }
+  const profile = getProfile(profileKey, overrides);
+  return {
+    enabled: playerSetting?.loudnessNormalize === true,
+    profile,
+    engine: playerSetting?.loudnessEngine ?? 'auto',
+    bypass: playerSetting?.loudnessBypass === true,
+    prefetchNext: playerSetting?.loudnessPrefetchNext !== false,
+  };
+};
+
+/* --------------------------------------------------------------- status */
+
+type StatusListener = (status: LoudnessStatus) => void;
+
+const statusListeners = new Set<StatusListener>();
+let lastStatus: LoudnessStatus = {
+  songId: '',
+  name: '',
+  stage: 'idle',
+  mode: 'off',
+  at: 0,
+};
+
+export const subscribeStatus = (listener: StatusListener) => {
+  statusListeners.add(listener);
+  listener(lastStatus);
+  return () => {
+    statusListeners.delete(listener);
+  };
+};
+
+export const getLastStatus = () => lastStatus;
+
+const emitStatus = (
+  patch: Partial<LoudnessStatus> & { stage: LoudnessStatus['stage'] },
+) => {
+  lastStatus = {
+    songId: patch.songId ?? '',
+    name: patch.name ?? '',
+    at: Date.now(),
+    mode: loudnessEngine.getMode(),
+    ...patch,
+  };
+  statusListeners.forEach((listener) => listener(lastStatus));
+  return lastStatus;
+};
+
+/* ---------------------------------------------------------------- cache */
+
+const memCache = new Map<string, LoudnessMeasurement>();
+const inFlight = new Map<string, Promise<LoudnessMeasurement>>();
+
+const rememberMeasurement = (
+  songId: string,
+  measurement: LoudnessMeasurement,
+) => {
+  memCache.set(songId, measurement);
+  storeMeasurement(songId, measurement);
+};
+
+/* --------------------------------------------------------------- engine */
+
+const pickEngine = (
+  setting: LoudnessSetting,
+  url?: string,
+): LoudnessEngineKind => {
+  if (setting.engine === 'ffmpeg') return 'ffmpeg';
+  if (setting.engine === 'sidx') return 'sidx';
+  return isBiliCdnUrl(url) ? 'sidx' : 'ffmpeg';
+};
+
+interface MeasureHooks {
+  onPartial?: (measurement: LoudnessMeasurement) => void;
+  onStage?: (stage: string) => void;
+}
+
+const measureStream = async (
+  kind: LoudnessEngineKind,
+  url: string,
+  setting: LoudnessSetting,
+  hooks?: MeasureHooks,
+): Promise<LoudnessMeasurement> => {
+  if (kind === 'ffmpeg') return measureStreamLoudnessWithFFmpeg(url);
+
+  // lazy import: keeps the sampler (and its OfflineAudioContext) out of the
+  // path when the user picked the ffmpeg engine
+  const { sampleStreamLoudness } = await import('./sampler');
+  try {
+    return await sampleStreamLoudness(url, {
+      onPartial: hooks?.onPartial,
+      onStage: hooks?.onStage,
+    });
+  } catch (e) {
+    if (setting.engine !== 'auto') throw e;
+    logger.notice(
+      `[loudness] sampling failed (${e}); falling back to the ffmpeg engine`,
+    );
+    return measureStreamLoudnessWithFFmpeg(url);
+  }
+};
+
+const resolveUrl = async (
+  opts: NormalizeOptions,
+): Promise<string | undefined> => {
+  if (opts.url) return opts.url;
+  if (!opts.getSource) return undefined;
+  const resolved = await opts.getSource();
+  return resolved?.url;
+};
+
+/** measure (or read from cache) the integrated loudness of a track */
+const getMeasurement = async (
+  opts: NormalizeOptions,
+  setting: LoudnessSetting,
+  hooks?: MeasureHooks,
+): Promise<{ measurement: LoudnessMeasurement; fromCache: boolean }> => {
+  const songId = opts.song.id;
+
+  const cached = memCache.get(songId);
+  if (cached) return { measurement: cached, fromCache: true };
+
+  const running = inFlight.get(songId);
+  if (running) return { measurement: await running, fromCache: true };
+
+  const task = (async () => {
+    const stored = await getStoredMeasurement(songId);
+    if (stored) {
+      memCache.set(songId, stored);
+      return stored;
+    }
+
+    const url = await resolveUrl(opts);
+    if (!url) throw new Error('no stream url to measure');
+
+    const kind = pickEngine(setting, url);
+    hooks?.onStage?.(kind === 'sidx' ? 'sampling' : 'ffmpeg');
+    const measurement = await measureStream(kind, url, setting, hooks);
+    rememberMeasurement(songId, measurement);
+    return measurement;
+  })();
+
+  inFlight.set(songId, task);
+  try {
+    return { measurement: await task, fromCache: false };
+  } finally {
+    inFlight.delete(songId);
+  }
+};
+
+/* ------------------------------------------------------------ applying */
+
+const applyPlan = (
+  plan: GainPlan,
+  opts?: { immediate?: boolean; force?: boolean },
+) => {
+  const current = loudnessEngine.getDesiredGainDb();
+  if (!opts?.force && Math.abs(plan.gainDb - current) < 0.01) return false;
+  loudnessEngine.setGainDb(plan.gainDb, { immediate: opts?.immediate });
+  return true;
+};
+
+const attachElement = (el?: HTMLAudioElement | null) => {
+  if (!el) return;
+  // attach() only awaits when the context still has to resume, so a running
+  // context takes the element over synchronously, before playback starts.
+  loudnessEngine
+    .attach(el)
+    .then((ok) => {
+      if (!ok) loudnessEngine.enterVolumeMode(el);
+      return undefined;
+    })
+    .catch(() => undefined);
+};
+
+/**
+ * Synchronous preparation, called from `musicSrcParser` before the player
+ * assigns the new src:
+ *   - takes the element over (or falls back to volume attenuation)
+ *   - puts the new track's gain in place *before* it is audible
+ *   - marks B站 CDN streams as CORS enabled, required for the audio graph
+ */
+export const resolveForPlayback = (opts: NormalizeOptions) => {
+  const setting = resolveLoudnessSetting(opts.playerSetting);
+  const songId = opts.song.id;
+  const el = opts.mediaElement;
+
+  if (!setting.enabled) {
+    loudnessEngine.setGainDb(0, { immediate: true });
+    return emitStatus({
+      songId,
+      name: opts.song.name,
+      stage: 'skipped',
+      reason: 'loudness normalization disabled',
+    });
+  }
+
+  loudnessEngine.setBypass(setting.bypass);
+
+  if (
+    el &&
+    opts.url &&
+    isBiliCdnUrl(opts.url) &&
+    el.crossOrigin !== 'anonymous'
+  ) {
+    // verified: the B站 CDNs answer with `Access-Control-Allow-Origin: *`
+    el.crossOrigin = 'anonymous';
+  }
+
+  const cached = memCache.get(songId);
+  if (cached) {
+    const plan = planGain(cached, setting.profile);
+    applyPlan(plan, { immediate: true, force: true });
+    attachElement(el);
+    emitStatus({
+      songId,
+      name: opts.song.name,
+      stage: 'cache-hit',
+      engine: cached.engine,
+      measuredLufs: cached.measuredLufs,
+      truePeakDb: cached.truePeakDb ?? undefined,
+      targetLufs: plan.targetLufs,
+      gainDb: plan.gainDb,
+      segments: cached.segments,
+      reason: plan.limitReason ?? undefined,
+    });
+  } else {
+    // start from the original audio: a wrong gain is worse than no gain
+    loudnessEngine.setGainDb(0, { immediate: true });
+    attachElement(el);
+  }
+
+  return lastStatus;
+};
+
+/** Measure (or read the cache) and ramp to the fixed gain. */
+export const normalizeSong = async (opts: NormalizeOptions) => {
+  const setting = resolveLoudnessSetting(opts.playerSetting);
+  const songId = opts.song.id;
+
+  if (opts.prefetchOnly) {
+    // silent warm-up of the next track: measure + cache, never touch output
+    if (!setting.enabled) return lastStatus;
+    try {
+      await getMeasurement(opts, setting);
+    } catch (e) {
+      logger.debug(`[loudness] prefetch skipped for ${songId}: ${e}`);
+    }
+    return lastStatus;
+  }
+
+  if (!setting.enabled) {
+    return emitStatus({
+      songId,
+      name: opts.song.name,
+      stage: 'skipped',
+      reason: 'loudness normalization disabled',
+    });
+  }
+
+  try {
+    const { measurement, fromCache } = await getMeasurement(opts, setting, {
+      onPartial: (partial) => {
+        // progressive landing: land early, re-land only on a real change
+        const partialPlan = planGain(partial, setting.profile);
+        const current = loudnessEngine.getDesiredGainDb();
+        if (Math.abs(partialPlan.gainDb - current) < REFINE_MIN_DELTA_DB)
+          return;
+        applyPlan(partialPlan, { force: true });
+        emitStatus({
+          songId,
+          name: opts.song.name,
+          stage: 'applied',
+          engine: partial.engine,
+          measuredLufs: partial.measuredLufs,
+          truePeakDb: partial.truePeakDb ?? undefined,
+          targetLufs: partialPlan.targetLufs,
+          gainDb: partialPlan.gainDb,
+          segments: partial.segments,
+          reason: 'provisional (first batch)',
+        });
+      },
+    });
+
+    const plan = planGain(measurement, setting.profile);
+    applyPlan(plan, { force: true });
+    logger.info(
+      `[loudness] ${opts.song.name || songId}: ${measurement.measuredLufs} LUFS ` +
+        `-> target ${plan.targetLufs} LUFS, gain ${plan.gainDb}dB ` +
+        `(${measurement.engine}${fromCache ? ', cache' : ''})`,
+    );
+    return emitStatus({
+      songId,
+      name: opts.song.name,
+      stage: fromCache ? 'cache-hit' : 'applied',
+      engine: measurement.engine,
+      measuredLufs: measurement.measuredLufs,
+      truePeakDb: measurement.truePeakDb ?? undefined,
+      targetLufs: plan.targetLufs,
+      gainDb: plan.gainDb,
+      segments: measurement.segments,
+      reason: plan.limitReason ?? undefined,
+    });
+  } catch (e) {
+    logger.notice(`[loudness] measurement failed for ${songId}: ${e}`);
+    return emitStatus({
+      songId,
+      name: opts.song.name,
+      stage: 'failed',
+      mode: loudnessEngine.getMode(),
+      reason: String(e),
+    });
+  }
+};
+
+/** Measure the next track while the current one plays (keeps switches seamless). */
+export const prefetchSong = (opts: Omit<NormalizeOptions, 'prefetchOnly'>) =>
+  normalizeSong({ ...opts, prefetchOnly: true });
+
+/** Drop every cached measurement (memory + database). */
+export const clearLoudnessCache = async () => {
+  memCache.clear();
+  const ok = await clearStoredMeasurements();
+  emitStatus({
+    songId: '',
+    name: '',
+    stage: 'idle',
+    reason: ok ? 'cache cleared' : 'cache clear failed',
+  });
+  return ok;
+};
+
+/**
+ * True while the fallback mode writes `element.volume`. The player persists
+ * every volumechange as the user's default volume, which must not pick up our
+ * normalization write.
+ */
+export const isWritingVolume = () => loudnessEngine.isWritingVolume();
+
+export default {
+  resolveForPlayback,
+  normalizeSong,
+  prefetchSong,
+  clearLoudnessCache,
+  resolveLoudnessSetting,
+  subscribeStatus,
+  getLastStatus,
+  isWritingVolume,
+};
diff --git a/src/utils/audio/loudness/sampler.ts b/src/utils/audio/loudness/sampler.ts
new file mode 100644
index 0000000..29546e6
--- /dev/null
+++ b/src/utils/audio/loudness/sampler.ts
@@ -0,0 +1,386 @@
+/* ================================================================
+ * sampler.ts — Range sampling + fragment decoding.
+ *
+ * Ported from Bilibili_LoudNorm/src/sampler.js (MIT, (c) 2026 Moxia9527),
+ * with the userscript specific `GM_xmlhttpRequest` fallback dropped: an
+ * extension page with host permissions can fetch the CDN directly.
+ *
+ * Why sampling instead of downloading the whole file: B站 audio is a single
+ * fMP4 with a sidx index, so ~0.5MB of evenly spread 5s fragments (~60s of
+ * audio, <1% of a long video) reproduces the integrated loudness of the whole
+ * track closely enough to level playlists.
+ *
+ * Decoding rules learned the hard way:
+ *   - `init` (ftyp+moov) + exactly ONE moof segment per decode call. Gluing
+ *     several moofs together makes the decoder emit only the first one
+ *     (measured: 57.3s of samples decoded to 4.9s, 2.9 LU off).
+ * ================================================================ */
+import { logger } from '@utils/Logger';
+
+import {
+  DECODE_SAMPLE_RATE,
+  FETCH_TIMEOUT_MS,
+  FIRST_BATCH_EAGER_AT,
+  FIRST_BATCH_SEGMENTS,
+  HEAD_WINDOW_BYTES,
+  MIN_SEGMENTS_TO_PROCEED,
+  REQUEST_GAP_MS,
+  SAMPLE_SEGMENTS,
+  SEGMENT_CONCURRENCY,
+  SEGMENT_RETRY,
+  SEGMENT_RETRY_DELAY_MS,
+  SEGMENT_TIMEOUT_MS,
+} from './config';
+import { concatPcm, measureLoudness } from './bs1770';
+import {
+  findBox,
+  parseSidx,
+  pickCoarse,
+  pickEvenly,
+  startsWithBox,
+  verifySidx,
+} from './sidx';
+import { LoudnessMeasurement, PcmChannels, SidxRef } from './types';
+
+export interface SampleOptions {
+  sampleSegments?: number;
+  firstBatch?: number;
+  eagerAt?: number;
+  concurrency?: number;
+  mimeType?: string;
+  signal?: AbortSignal;
+  /** fired once as soon as the first batch is in (progressive landing) */
+  onPartial?: (measurement: LoudnessMeasurement) => void;
+  onStage?: (stage: string) => void;
+}
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+/** Yield to the event loop; keeps the player UI smooth during the math. */
+export const yieldToEventLoop = () =>
+  new Promise<void>((resolve) => {
+    setTimeout(resolve, 0);
+  });
+
+interface RangeResponse {
+  bytes: ArrayBuffer;
+  /** total file size from Content-Range, when the server reports it */
+  totalBytes: number | null;
+}
+
+/** One Range request with timeout + retry. */
+const fetchRangeWithMeta = async (
+  url: string,
+  start: number,
+  end: number,
+  opts?: { timeoutMs?: number; retries?: number; signal?: AbortSignal },
+): Promise<RangeResponse> => {
+  const budget = opts?.timeoutMs ?? FETCH_TIMEOUT_MS;
+  const maxTries = 1 + (opts?.retries ?? 0);
+  const rangeValue = `bytes=${start}-${end}`;
+
+  let lastError: unknown = null;
+  for (let attempt = 0; attempt < maxTries; attempt += 1) {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), budget);
+    const onOuterAbort = () => controller.abort();
+    opts?.signal?.addEventListener('abort', onOuterAbort);
+    try {
+      // eslint-disable-next-line no-await-in-loop
+      const res = await fetch(url, {
+        headers: { Range: rangeValue },
+        signal: controller.signal,
+      });
+      if (res.status !== 206 && !res.ok) {
+        throw new Error(`HTTP ${res.status} for ${rangeValue}`);
+      }
+      const contentRange = res.headers.get('Content-Range');
+      const totalBytes = contentRange
+        ? Number(contentRange.split('/')[1]) || null
+        : null;
+      // eslint-disable-next-line no-await-in-loop
+      const bytes = await res.arrayBuffer();
+      return { bytes, totalBytes };
+    } catch (e) {
+      lastError = e;
+      if (opts?.signal?.aborted) throw e;
+      if (attempt + 1 < maxTries) {
+        // eslint-disable-next-line no-await-in-loop
+        await sleep(SEGMENT_RETRY_DELAY_MS);
+      }
+    } finally {
+      clearTimeout(timer);
+      opts?.signal?.removeEventListener('abort', onOuterAbort);
+    }
+  }
+  throw lastError ?? new Error('fetchRange failed');
+};
+
+export const fetchRange = async (
+  url: string,
+  start: number,
+  end: number,
+  opts?: { timeoutMs?: number; retries?: number; signal?: AbortSignal },
+) => (await fetchRangeWithMeta(url, start, end, opts)).bytes;
+
+/**
+ * Bounded concurrency with a minimum gap between request starts, so a fast
+ * CDN does not trip B站's frequency control.
+ */
+const pacedPool = async <T>(
+  items: T[],
+  limit: number,
+  worker: (item: T, index: number) => Promise<void>,
+) => {
+  let next = 0;
+  let lastStart = 0;
+  const runners: Promise<void>[] = [];
+  const n = Math.max(1, Math.min(limit, items.length || 1));
+
+  const runner = async () => {
+    for (;;) {
+      const index = next;
+      next += 1;
+      if (index >= items.length) return;
+
+      const wait = lastStart + REQUEST_GAP_MS - Date.now();
+      if (wait > 0) {
+        // eslint-disable-next-line no-await-in-loop
+        await sleep(wait);
+      }
+      lastStart = Date.now();
+      // eslint-disable-next-line no-await-in-loop
+      await worker(items[index], index);
+    }
+  };
+
+  for (let i = 0; i < n; i += 1) runners.push(runner());
+  await Promise.all(runners);
+};
+
+/** A decode-only context; offline so it never touches the audible output. */
+let decodeContext: BaseAudioContext | null = null;
+const getDecodeContext = (): BaseAudioContext => {
+  if (decodeContext) return decodeContext;
+  const OfflineCtor =
+    globalThis.OfflineAudioContext ||
+    (globalThis as { webkitOfflineAudioContext?: typeof OfflineAudioContext })
+      .webkitOfflineAudioContext;
+  if (!OfflineCtor) throw new Error('OfflineAudioContext unavailable');
+  decodeContext = new OfflineCtor(1, 1, DECODE_SAMPLE_RATE);
+  return decodeContext;
+};
+
+/** Decode `init + one segment` into plain PCM channels. */
+export const decodeFragment = async (
+  init: ArrayBuffer,
+  segment: ArrayBuffer,
+  mimeType = 'audio/mp4',
+): Promise<PcmChannels> => {
+  const blob = new Blob([init, segment], { type: mimeType });
+  const bytes = await blob.arrayBuffer();
+  const audioBuffer = await getDecodeContext().decodeAudioData(bytes);
+  const channels: Float32Array[] = [];
+  for (let c = 0; c < audioBuffer.numberOfChannels; c += 1) {
+    // copy: the AudioBuffer view is only valid while the buffer is alive
+    channels.push(new Float32Array(audioBuffer.getChannelData(c)));
+  }
+  return { channels, sampleRate: audioBuffer.sampleRate };
+};
+
+export interface SidxHead {
+  /** init segment (ftyp+moov), everything before the sidx box */
+  init: ArrayBuffer;
+  /** absolute offset right after the sidx box (the `first_offset` anchor) */
+  anchor: number;
+  refs: SidxRef[];
+  /** file size reported by the CDN, when available */
+  totalBytes: number | null;
+}
+
+/**
+ * Fetch just enough of the file to locate and parse the sidx index.
+ * The head window normally covers it; long tracks (16KB+ index) need a second
+ * Range request, which is cheap.
+ */
+export const fetchSidxHead = async (
+  url: string,
+  opts?: { signal?: AbortSignal },
+): Promise<SidxHead> => {
+  const head = await fetchRangeWithMeta(url, 0, HEAD_WINDOW_BYTES - 1, {
+    signal: opts?.signal,
+  });
+
+  const header = findBox(head.bytes, 'sidx');
+  if (!header) throw new Error('no sidx box in the head window');
+
+  let buffer = head.bytes;
+  const sidxEnd = header.offset + header.size;
+  if (sidxEnd > head.bytes.byteLength) {
+    const rest = await fetchRangeWithMeta(
+      url,
+      head.bytes.byteLength,
+      sidxEnd - 1,
+      {
+        signal: opts?.signal,
+      },
+    );
+    const merged = new Uint8Array(sidxEnd);
+    merged.set(new Uint8Array(head.bytes), 0);
+    merged.set(new Uint8Array(rest.bytes), head.bytes.byteLength);
+    buffer = merged.buffer;
+  }
+
+  const anchor = sidxEnd;
+  const parsed = parseSidx(buffer, anchor);
+  if (!parsed || !parsed.refs.length) {
+    throw new Error('sidx parsed to zero references');
+  }
+
+  const check = verifySidx(parsed, head.totalBytes ?? undefined);
+  if (check.ok === false) {
+    logger.notice(
+      `[loudness] index self check failed: computed ${check.endOffset} vs ` +
+        `content-length ${check.contentLength} (diff ${check.diff})`,
+    );
+  }
+
+  return {
+    init: buffer.slice(0, header.offset),
+    anchor,
+    refs: parsed.refs,
+    totalBytes: head.totalBytes,
+  };
+};
+
+/**
+ * Measure the integrated loudness of a stream by sampling it.
+ *
+ * @param url resolved audio URL (only needs Range support)
+ */
+export const sampleStreamLoudness = async (
+  url: string,
+  opts?: SampleOptions,
+): Promise<LoudnessMeasurement> => {
+  const started = Date.now();
+  const stage = opts?.onStage ?? (() => undefined);
+  const wantSegments = opts?.sampleSegments ?? SAMPLE_SEGMENTS;
+  const firstBatch = opts?.firstBatch ?? FIRST_BATCH_SEGMENTS;
+  const eagerAt = opts?.eagerAt ?? FIRST_BATCH_EAGER_AT;
+  const mimeType = opts?.mimeType ?? 'audio/mp4';
+
+  stage('index');
+  const { init, refs, anchor, totalBytes } = await fetchSidxHead(url, {
+    signal: opts?.signal,
+  });
+  logger.debug(
+    `[loudness] sidx: ${refs.length} refs of ${refs[0]?.duration.toFixed(2)}s, ` +
+      `anchor ${anchor}, head window ${HEAD_WINDOW_BYTES / 1024}KiB, ` +
+      `total ${totalBytes ?? 'unknown'}`,
+  );
+
+  const picks = pickEvenly(refs, wantSegments);
+  const coarse = pickCoarse(picks, firstBatch);
+  const rest = picks.filter((i) => !coarse.includes(i));
+
+  const parts: PcmChannels[] = [];
+  const pending: Promise<void>[] = [];
+  let partialSent = false;
+
+  const measureNow = async (): Promise<LoudnessMeasurement | null> => {
+    const pcm = concatPcm(parts);
+    if (!pcm || !pcm.channels.length || !pcm.channels[0].length) return null;
+    const core = await measureLoudness(pcm, { onYield: yieldToEventLoop });
+    if (core.lufs === null) return null;
+    return {
+      measuredLufs: core.lufs,
+      truePeakDb: core.truePeakDb,
+      engine: 'sidx',
+      segments: parts.length,
+      elapsedMs: Date.now() - started,
+    };
+  };
+
+  let misalignedSegments = 0;
+  const decodeInto = async (index: number, bytes: ArrayBuffer) => {
+    // A wrong sidx anchor is the classic failure mode: every segment but the
+    // first points at garbage. Say so instead of failing silently.
+    if (!startsWithBox(bytes, 'moof')) {
+      misalignedSegments += 1;
+      if (misalignedSegments === 1) {
+        logger.notice(
+          `[loudness] segment ${index} does not start with a moof box - ` +
+            'the segment index may be misaligned',
+        );
+      }
+    }
+    try {
+      const pcm = await decodeFragment(init, bytes, mimeType);
+      parts.push(pcm);
+      if (!partialSent && parts.length >= eagerAt) {
+        partialSent = true;
+        const partial = await measureNow();
+        if (partial && opts?.onPartial) opts.onPartial(partial);
+      }
+    } catch (e) {
+      // one broken segment must not sink the whole measurement
+      logger.notice(`[loudness] segment ${index} decode failed: ${e}`);
+    }
+  };
+
+  const download = async (segmentIndexes: number[], label: string) => {
+    stage(label);
+    await pacedPool(
+      segmentIndexes,
+      opts?.concurrency ?? SEGMENT_CONCURRENCY,
+      async (index) => {
+        const ref = refs[index];
+        try {
+          const bytes = await fetchRange(
+            url,
+            ref.offset,
+            ref.offset + ref.size - 1,
+            {
+              timeoutMs: SEGMENT_TIMEOUT_MS,
+              retries: SEGMENT_RETRY,
+              signal: opts?.signal,
+            },
+          );
+          pending.push(decodeInto(index, bytes));
+        } catch (e) {
+          logger.notice(`[loudness] segment ${index} fetch failed: ${e}`);
+        }
+      },
+    );
+  };
+
+  await download(coarse, 'sample-first-batch');
+  await Promise.all(pending.splice(0));
+
+  if (parts.length < MIN_SEGMENTS_TO_PROCEED) {
+    throw new Error(
+      `not enough segments decoded (${parts.length}/${MIN_SEGMENTS_TO_PROCEED})`,
+    );
+  }
+
+  if (rest.length) {
+    await download(rest, 'sample-refine');
+    await Promise.all(pending.splice(0));
+  }
+
+  const final = await measureNow();
+  if (!final) throw new Error('loudness measurement produced no gated blocks');
+  logger.debug(
+    `[loudness] sampled ${final.segments} segments in ${final.elapsedMs}ms ` +
+      `-> ${final.measuredLufs} LUFS / ${final.truePeakDb} dBTP`,
+  );
+  return { ...final, elapsedMs: Date.now() - started };
+};
+
+export default {
+  sampleStreamLoudness,
+  fetchRange,
+  fetchSidxHead,
+  decodeFragment,
+  yieldToEventLoop,
+};
