+/* ================================================================
+ * bs1770.ts — ITU-R BS.1770-4 integrated loudness + true peak.
+ *
+ * Ported from Bilibili_LoudNorm/src/loudness.js (MIT, (c) 2026 Moxia9527).
+ *
+ *   a) K-weighting = high shelf (+4dB @1682Hz) -> high pass (38Hz),
+ *      coefficients computed for the actual sample rate
+ *   b) 400ms blocks, 100ms step (75% overlap)
+ *   c) block loudness l_j = -0.691 + 10*log10( sum_i G_i * z_ij )
+ *   d) absolute gate: drop blocks below -70 LUFS
+ *   e) relative gate: gamma = mean energy of surviving blocks - 10 LU
+ *   f) integrated = -0.691 + 10*log10( sum z / N ) over gated blocks
+ *   g) true peak = max |sample| of the unweighted PCM
+ *
+ * Channel energies are summed, NOT averaged: BS.1770 weights channels
+ * (L=R=1.0, C=Ls=Rs=1.41), so the same signal in both channels reads 3.01dB
+ * louder than mono. Averaging by channel count silently lowered every stereo
+ * track by 3dB and broke the comparison against B站's own metadata.
+ * ================================================================ */
+import { LUM_CHUNK_FRAMES } from './config';
+import { LoudnessCore, PcmChannels } from './types';
+
+const OFFSET_691 = -0.691;
+const ABS_GATE_LUFS = -70;
+const REL_GATE_LU = 10;
+
+export interface BiquadCoeffs {
+  b0: number;
+  b1: number;
+  b2: number;
+  a1: number;
+  a2: number;
+}
+
+export interface BiquadState {
+  x1: number;
+  x2: number;
+  y1: number;
+  y2: number;
+}
+
+export const biquadState = (): BiquadState => ({ x1: 0, x2: 0, y1: 0, y2: 0 });
+
+/** High shelf: G=+3.999843853973347 dB, fc=1681.974450955533 Hz, Q=0.7071752369554196 */
+export const highShelfCoeffs = (fs: number): BiquadCoeffs => {
+  const G = 3.999843853973347;
+  const Q = 0.7071752369554196;
+  const fc = 1681.974450955533;
+
+  const K = Math.tan((Math.PI * fc) / fs);
+  const Vh = 10 ** (G / 20);
+  const Vb = Vh ** 0.4996667741545416;
+  const a0 = 1 + K / Q + K * K;
+
+  return {
+    b0: (Vh + (Vb * K) / Q + K * K) / a0,
+    b1: (2 * (K * K - Vh)) / a0,
+    b2: (Vh - (Vb * K) / Q + K * K) / a0,
+    a1: (2 * (K * K - 1)) / a0,
+    a2: (1 - K / Q + K * K) / a0,
+  };
+};
+
+/**
+ * High pass: fc=38.13547087602444 Hz, Q=0.5003270373238773.
+ *
+ * The numerator is intentionally NOT divided by a0 (b = [1, -2, 1]): that is
+ * the BS.1770-4 form, which carries +0.043dB of gain. Normalizing it the
+ * usual way makes every measurement 0.043dB low.
+ */
+export const highPassCoeffs = (fs: number): BiquadCoeffs => {
+  const Q = 0.5003270373238773;
+  const fc = 38.13547087602444;
+
+  const K = Math.tan((Math.PI * fc) / fs);
+  const a0 = 1 + K / Q + K * K;
+
+  return {
+    b0: 1,
+    b1: -2,
+    b2: 1,
+    a1: (2 * (K * K - 1)) / a0,
+    a2: (1 - K / Q + K * K) / a0,
+  };
+};
+
+/**
+ * Direct form I biquad, in place, over x[start, end).
+ * The state is carried across calls so chunked filtering is bit-identical to
+ * filtering the whole buffer at once.
+ */
+export const biquadRange = (
+  x: Float32Array,
+  start: number,
+  end: number,
+  c: BiquadCoeffs,
+  st: BiquadState,
+) => {
+  let { x1, x2, y1, y2 } = st;
+  for (let i = start; i < end; i += 1) {
+    const xi = x[i];
+    const yi = c.b0 * xi + c.b1 * x1 + c.b2 * x2 - c.a1 * y1 - c.a2 * y2;
+    x2 = x1;
+    x1 = xi;
+    y2 = y1;
+    y1 = yi;
+    x[i] = yi;
+  }
+  st.x1 = x1;
+  st.x2 = x2;
+  st.y1 = y1;
+  st.y2 = y2;
+};
+
+export const biquadInPlace = (x: Float32Array, c: BiquadCoeffs) => {
+  biquadRange(x, 0, x.length, c, biquadState());
+};
+
+export const peakOf = (x: Float32Array) => {
+  let peak = 0;
+  for (let i = 0; i < x.length; i += 1) {
+    const a = x[i] < 0 ? -x[i] : x[i];
+    if (a > peak) peak = a;
+  }
+  return peak;
+};
+
+export interface MeasureOptions {
+  /** called between chunks so a UI can stay responsive */
+  onYield?: () => Promise<void> | void;
+  /** chunk size in frames; defaults to LUM_CHUNK_FRAMES */
+  chunkFrames?: number;
+}
+
+/**
+ * Concatenate decoded fragments into one continuous PCM buffer.
+ *
+ * The fragments are far apart in the original track, so a hard cut would
+ * create a step at every boundary; 5ms fades cost less than 0.01dB of
+ * measured loudness and keep the waveform clean.
+ *
+ */
+export const concatPcm = (parts: PcmChannels[]): PcmChannels | null => {
+  const usable = (parts || []).filter((p) => p && p.channels.length);
+  if (!usable.length) return null;
+
+  const sampleRate = usable[0].sampleRate;
+  const channelCount = usable.reduce(
+    (min, p) => Math.min(min, p.channels.length),
+    usable[0].channels.length,
+  );
+  const total = usable.reduce((sum, p) => sum + p.channels[0].length, 0);
+  const fade = Math.min(Math.round(0.005 * sampleRate), Math.floor(total / 8));
+
+  const channels: Float32Array[] = [];
+  for (let c = 0; c < channelCount; c += 1) {
+    channels.push(new Float32Array(total));
+  }
+
+  let offset = 0;
+  usable.forEach((part) => {
+    const length = part.channels[0].length;
+    for (let c = 0; c < channelCount; c += 1) {
+      const dst = channels[c];
+      dst.set(part.channels[c], offset);
+      for (let i = 0; i < fade; i += 1) {
+        const w = i / fade;
+        dst[offset + i] *= w;
+        dst[offset + length - 1 - i] *= w;
+      }
+    }
+    offset += length;
+  });
+
+  return { channels, sampleRate };
+};
+
+/**
+ * BS.1770-4 integrated loudness of the given PCM.
+ * Pure: no DOM, no globals, safe to unit test under plain Node.
+ */
+export const measureLoudness = async (
+  pcm: PcmChannels,
+  opts?: MeasureOptions,
+): Promise<LoudnessCore> => {
+  const options = opts || {};
+  const { sampleRate: fs, channels } = pcm;
+  const frames = channels[0]?.length ?? 0;
+
+  const hs = highShelfCoeffs(fs);
+  const hp = highPassCoeffs(fs);
+
+  /** per frame sum of K-weighted channel energy (sum, not average: see header) */
+  const z = new Float64Array(frames + 1);
+  let truePeakLinear = 0;
+
+  const chunk = Math.max(
+    1,
+    Math.min(
+      frames,
+      Math.floor(options.chunkFrames ?? LUM_CHUNK_FRAMES) || frames,
+    ),
+  );
+  const wantYield = typeof options.onYield === 'function';
+  let lastYield = Date.now();
+
+  for (let ch = 0; ch < channels.length; ch += 1) {
+    const src = channels[ch];
+    const buf = new Float32Array(frames);
+    buf.set(src);
+
+    const st1 = biquadState();
+    const st2 = biquadState();
+
+    for (let s = 0; s < frames; s += chunk) {
+      const e = Math.min(s + chunk, frames);
+
+      // Unweighted peak, scanned before the filters rewrite the buffer.
+      let pk = 0;
+      for (let i = s; i < e; i += 1) {
+        const a = buf[i] < 0 ? -buf[i] : buf[i];
+        if (a > pk) pk = a;
+      }
+      if (pk > truePeakLinear) truePeakLinear = pk;
+
+      biquadRange(buf, s, e, hs, st1);
+      biquadRange(buf, s, e, hp, st2);
+
+      for (let i = s; i < e; i += 1) {
+        const v = buf[i];
+        z[i] += v * v;
+      }
+
+      if (wantYield && Date.now() - lastYield > 8) {
+        lastYield = Date.now();
+        // eslint-disable-next-line no-await-in-loop
+        await options.onYield?.();
+      }
+    }
+  }
+
+  const blockLen = Math.round(0.4 * fs);
+  const stepLen = Math.round(0.1 * fs);
+
+  const blockEnergy: number[] = [];
+  if (frames >= blockLen) {
+    for (let s = 0; s + blockLen <= frames; s += stepLen) {
+      let sum = 0;
+      for (let i = s; i < s + blockLen; i += 1) sum += z[i];
+      blockEnergy.push(sum / blockLen);
+    }
+  }
+
+  const lufsOf = (energy: number) =>
+    OFFSET_691 + 10 * Math.log10(energy > 0 ? energy : 1e-12);
+
+  const stage1 = blockEnergy.filter((e) => lufsOf(e) >= ABS_GATE_LUFS);
+
+  let integrated: number | null = null;
+  let stage2: number[] = [];
+  if (stage1.length) {
+    const sum = stage1.reduce((a, b) => a + b, 0);
+    const gamma = lufsOf(sum / stage1.length) - REL_GATE_LU;
+    stage2 = stage1.filter((e) => lufsOf(e) >= gamma);
+    const use = stage2.length ? stage2 : stage1;
+    const sum2 = use.reduce((a, b) => a + b, 0);
+    integrated = lufsOf(sum2 / use.length);
+  }
+
+  const truePeakDb =
+    20 * Math.log10(truePeakLinear > 0 ? truePeakLinear : 1e-12);
+
+  return {
+    lufs: integrated === null ? null : Number(integrated.toFixed(2)),
+    truePeakDb: Number(truePeakDb.toFixed(2)),
+    blocks: blockEnergy.length,
+    blocksAfterAbsGate: stage1.length,
+    blocksAfterRelGate: stage2.length,
+    frames,
+    sampleRate: fs,
+    channels: channels.length,
+  };
+};
+
+export default {
+  measureLoudness,
+  concatPcm,
+  highShelfCoeffs,
+  highPassCoeffs,
+  biquadInPlace,
+  biquadRange,
+  biquadState,
+  peakOf,
+};
