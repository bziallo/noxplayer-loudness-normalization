@@ -0,0 +1,56 @@
+/* ================================================================
+ * imageHostFailover.ts — retry a cover on another B站 image shard.
+ *
+ * i0/i1/i2.hdslb.com are replicas of the same object store (verified: the same
+ * /bfs/archive/*.jpg comes back byte-identical from all three), but a single
+ * shard can be unreachable from a given network. The result is a missing cover
+ * plus a console full of ERR_CONNECTION_TIMED_OUT, while playback itself is
+ * perfectly fine.
+ *
+ * Image `error` events do not bubble, so the listener is registered in the
+ * capture phase; it covers every cover in the app (player, playlist, lyrics).
+ * ================================================================ */
+const SHARDS = ['i0.hdslb.com', 'i1.hdslb.com', 'i2.hdslb.com'];
+/** extra attempts per <img> before we let it stay broken */
+const MAX_EXTRA_TRIES = 2;
+
+const triedShards = new WeakMap<HTMLImageElement, Set<string>>();
+let installed = false;
+
+const retryOnAnotherShard = (img: HTMLImageElement) => {
+  const current = img.currentSrc || img.src;
+  let url: URL;
+  try {
+    url = new URL(current);
+  } catch {
+    return;
+  }
+  if (!SHARDS.includes(url.hostname)) return;
+
+  const history = triedShards.get(img) ?? new Set<string>();
+  triedShards.set(img, history);
+  history.add(url.hostname);
+  if (history.size > MAX_EXTRA_TRIES) return;
+
+  const next = SHARDS.find((host) => !history.has(host));
+  if (!next) return;
+  url.hostname = next;
+  console.info(`[cover] ${url.hostname} 不通，换镜像分片重试`);
+  img.src = url.toString();
+};
+
+/** Idempotent: safe to call from any effect. */
+export const installImageHostFailover = () => {
+  if (installed) return;
+  installed = true;
+  document.addEventListener(
+    'error',
+    (event) => {
+      const target = event.target;
+      if (target instanceof HTMLImageElement) retryOnAnotherShard(target);
+    },
+    true,
+  );
+};
+
+export default { installImageHostFailover };
-- 
