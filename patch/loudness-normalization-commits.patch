+/* ================================================================
+ * loudnessStorage.ts — pglite cache for loudness measurements.
+ *
+ * Every entry point swallows its errors: a cache (or a missing table, on an
+ * install that never ran the migration) must never break playback.
+ * ================================================================ */
+import { eq } from 'drizzle-orm';
+
+import { logger } from '@utils/Logger';
+import { LOUDNESS_ENGINE_VERSION } from '@utils/audio/loudness/config';
+import {
+  LoudnessEngineKind,
+  LoudnessMeasurement,
+} from '@utils/audio/loudness/types';
+
+import db from './sql';
+import loudnessTable from './schema/loudnessTable';
+
+export const getStoredMeasurement = async (
+  songcid: string,
+): Promise<LoudnessMeasurement | undefined> => {
+  if (!songcid) return undefined;
+  try {
+    const rows = await db
+      .select()
+      .from(loudnessTable)
+      .where(eq(loudnessTable.songcid, songcid));
+    const row = rows?.[0];
+    if (!row) return undefined;
+    // drop rows produced by an older version of the measurement math
+    if (row.engineVersion !== LOUDNESS_ENGINE_VERSION) return undefined;
+    if (row.measuredLufs === null || row.measuredLufs === undefined) {
+      return undefined;
+    }
+    return {
+      measuredLufs: row.measuredLufs,
+      truePeakDb: row.truePeakDb ?? null,
+      engine: (row.engine as LoudnessEngineKind) ?? 'sidx',
+      segments: row.segments ?? 0,
+      elapsedMs: 0,
+    };
+  } catch (e) {
+    logger.notice(`[loudness] cache read failed (${e}); will measure`);
+    return undefined;
+  }
+};
+
+export const storeMeasurement = async (
+  songcid: string,
+  measurement: LoudnessMeasurement,
+) => {
+  if (!songcid || !Number.isFinite(measurement.measuredLufs)) return;
+  const values = {
+    songcid,
+    measuredLufs: measurement.measuredLufs,
+    truePeakDb: measurement.truePeakDb,
+    engine: measurement.engine,
+    engineVersion: LOUDNESS_ENGINE_VERSION,
+    segments: measurement.segments,
+    updatedAt: Date.now(),
+  };
+  try {
+    await db.insert(loudnessTable).values(values).onConflictDoUpdate({
+      target: loudnessTable.songcid,
+      set: values,
+    });
+  } catch (e) {
+    logger.notice(`[loudness] cache write failed: ${e}`);
+  }
+};
+
+export const clearStoredMeasurements = async () => {
+  try {
+    await db.delete(loudnessTable);
+    return true;
+  } catch (e) {
+    logger.notice(`[loudness] cache clear failed: ${e}`);
+    return false;
+  }
+};
+
+export const countStoredMeasurements = async (): Promise<number> => {
+  try {
+    const rows = await db.select({ id: loudnessTable.id }).from(loudnessTable);
+    return rows?.length ?? 0;
+  } catch (e) {
+    return 0;
+  }
+};
+
+export default {
+  getStoredMeasurement,
+  storeMeasurement,
+  clearStoredMeasurements,
+  countStoredMeasurements,
+};
