+
+/** Gain profile / preset: the "loudness table" shown in the settings panel. */
+export interface GainProfile {
+  key: string;
+  label: string;
+  targetLufs: number;
+  maxBoostDb: number;
+  minGainDb: number;
+}
+
+/** Result of mapping a measurement onto a profile. */
+export interface GainPlan {
+  gainDb: number;
+  targetLufs: number;
+  rawGainDb: number | null;
+  limited: boolean;
+  limitReason: string | null;
+  ceilingHeadroom: number | null;
+  profileKey: string;
+}
+
+/** Everything the UI needs to explain what happened to the current track. */
+export interface LoudnessStatus {
+  songId: string;
+  name: string;
+  stage: 'idle' | 'cache-hit' | 'measuring' | 'applied' | 'failed' | 'skipped';
+  engine?: LoudnessEngineKind;
+  measuredLufs?: number;
+  truePeakDb?: number;
+  targetLufs?: number;
+  gainDb?: number;
+  segments?: number;
+  mode: LoudnessApplicationMode;
+  reason?: string;
+  at: number;
+}
+
+/** How the gain is actually being applied right now. */
+export type LoudnessApplicationMode = 'gain-node' | 'volume' | 'off';
