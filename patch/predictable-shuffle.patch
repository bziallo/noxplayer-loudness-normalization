+/** Fisher–Yates; returns a new array so callers can keep the original order */
+const shuffled = <T>(items: T[]): T[] => {
+  const out = [...items];
+  for (let i = out.length - 1; i > 0; i -= 1) {
+    const j = Math.floor(Math.random() * (i + 1));
+    const tmp = out[i];
+    out[i] = out[j];
+    out[j] = tmp;
+  }
+  return out;
+};
+
+/**
+ * "随机播放"是否采用**预先排好的随机队列**（B 站本体 / piliplus 的做法）：
+ * 队列顺序固定 → 播放列表里能看到下一首、也能提前测量以免切歌卡顿。
+ * 关掉 `smartShuffle` 时退回 RJKM 的实时随机（顺序不可预知）。
+ */
+const usesPredictableShuffle = (
+  playlist: NoxMedia.Playlist,
+  playerSetting: Partial<NoxStorage.PlayerSettingDict>,
+) =>
+  playlist?.repeatMode === NoxRepeatMode.Shuffle &&
+  playerSetting?.smartShuffle !== false;
+
+/** RJKM 的播放模式：可预知随机 = 按排好的队列顺序循环 */
+const rjkmPlayModeFor = (
+  playlist: NoxMedia.Playlist,
+  playerSetting: Partial<NoxStorage.PlayerSettingDict>,
+  fallback?: string,
+) =>
+  usesPredictableShuffle(playlist, playerSetting)
+    ? 'orderLoop'
+    : (NoxRepeatModeToRJKM[playlist?.repeatMode] ?? fallback);
+
