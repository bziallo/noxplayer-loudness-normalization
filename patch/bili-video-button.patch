+import React from 'react';
+
+import useApp from '@stores/useApp';
+import { BiliBiliIconSVG, goToBiliBili } from '../bilibiliIcon';
+
+interface Props {
+  song: NoxMedia.Song;
+}
+
+/**
+ * Player-area shortcut to the song's B站 video page — same idea as 电梓播放器's
+ * `buildExternalLink`: one click on the B站 icon opens the video in a new tab
+ * (with the right page number, thanks to `songExport2URL`).
+ *
+ * Only rendered for B站 sources; the playlist's right-click menu already offers
+ * the same action (`SongMenu` → 前往视频).
+ */
+export default function BiliVideoButton({ song }: Props) {
+  const { buttonStyle } = useApp((state) => state.playerStyle);
+  if (!song?.bvid || !(song.source ?? '').startsWith('bili')) return null;
+
+  return (
+    <span
+      className='group audio-download'
+      // @ts-expect-error emotion css prop is not in the JSX types
+      // eslint-disable-next-line react/no-unknown-property
+      css={buttonStyle}
+      title='前往 B 站视频'
+      role='button'
+      tabIndex={0}
+      onClick={() => goToBiliBili(song)}
+      onKeyDown={(event) => {
+        if (event.key === 'Enter' || event.key === ' ') goToBiliBili(song);
+      }}
+    >
+      <BiliBiliIconSVG />
+    </span>
+  );
+}
