diff --git a/src/utils/PlayQueue.ts b/src/utils/PlayQueue.ts
new file mode 100644
index 0000000..cb9b70d
--- /dev/null
+++ b/src/utils/PlayQueue.ts
@@ -0,0 +1,111 @@
+import APMshuffle from '@APM/utils/shuffle';
+import { useNoxSetting } from '@APM/stores/useApp';
+import { NoxRepeatModeToRJKM } from '@utils/RJKMUtils';
+import useApp from '@stores/useApp';
+
+/**
+ * react-jinke-music-player 用这个字段认"这首歌"（fork 的 config/player.js）。
+ * 我们自己给队列里的每一项都写上它，且**同一首歌每次都是同一个值**：
+ * 重排队列时 playId 才能对上，"当前播放的那首"不会被认错、也不会被打断。
+ */
+export const PLAY_QUEUE_KEY = '__PLAYER_KEY__';
+
+export const SHUFFLE_PLAY_MODE = 'shufflePlay';
+
+/** 队列项（Song 上多挂一个 RJKM 的 player key） */
+export type PlayQueueSong = NoxMedia.Song & { [PLAY_QUEUE_KEY]?: string };
+
+/** 给队列里的每首歌挂上稳定 key */
+export const withPlayerKeys = (songs: NoxMedia.Song[]): NoxMedia.Song[] =>
+  songs.map(
+    (song) =>
+      ({
+        ...song,
+        [PLAY_QUEUE_KEY]: `${song.bvid}-${song.id}`,
+      } as PlayQueueSong),
+  );
+
+/** RJKM 的 playMode：歌单自己的播放模式优先，其次才是播放器设置 */
+export const rjkmPlayModeFor = (
+  playlist?: NoxMedia.Playlist,
+  playerSetting?: Partial<NoxStorage.PlayerSettingDict>,
+  fallback?: string,
+) =>
+  playlist?.repeatMode !== undefined
+    ? NoxRepeatModeToRJKM[playlist.repeatMode]
+    : playerSetting?.playMode ?? fallback;
+
+/**
+ * 现在是不是"可预知的随机播放"：**随机时队列在开播前就排好**（B站本体/piliplus 的做法），
+ * 于是播放列表面板里看到的顺序就是实际播放顺序，下一首也能提前测量响度。
+ *
+ * 关掉设置里的 `smartShuffle` 时不做这件事，退回 RJKM 自己的实时随机。
+ */
+export const usesPredictableShuffle = (
+  playlist?: NoxMedia.Playlist,
+  playerSetting?: Partial<NoxStorage.PlayerSettingDict>,
+) =>
+  rjkmPlayModeFor(playlist, playerSetting) === SHUFFLE_PLAY_MODE &&
+  playerSetting?.smartShuffle !== false;
+
+/**
+ * 把一张歌单排成播放队列：随机模式下就是"预排好的随机顺序"，
+ * 用的还是播放器自带的 smart shuffle 算法（尽量不让同一首歌连着出现）。
+ */
+export const queueForPlaylist = (
+  playlist: NoxMedia.Playlist,
+  songList: NoxMedia.Song[],
+  playerSetting?: Partial<NoxStorage.PlayerSettingDict>,
+): NoxMedia.Song[] => {
+  const shuffle = APMshuffle(playerSetting?.smartShuffle !== false);
+  return withPlayerKeys(
+    usesPredictableShuffle(playlist, playerSetting)
+      ? shuffle(songList)
+      : songList,
+  );
+};
+
+/** 队列里的歌和歌单里的歌是不是同一批（不看顺序） */
+const sameSongs = (queue: NoxMedia.Song[], songList: NoxMedia.Song[]) =>
+  queue.length === songList.length &&
+  songList.every((song) => queue.some((q) => q.id === song.id));
+
+/**
+ * 随机开关被切换后，把**正在播的这条队列**换成新的顺序：
+ * 开随机 → 预排好的随机顺序；关随机 → 歌单原本的顺序。
+ *
+ * 只是换顺序：正在播的那首继续播（RJKM 侧走 keepCurrentAudioInList），
+ * 不会被切掉，也不会从头开始。
+ */
+export const resyncQueueOrder = (playlist?: NoxMedia.Playlist) => {
+  if (!playlist?.songList?.length) return;
+  const { playingList: queue, params } = useApp.getState();
+  if (!queue.length || !params?.audioLists?.length) return;
+  if (!sameSongs(queue, playlist.songList)) return;
+
+  const playerSetting = useNoxSetting.getState().playerSetting;
+  const predictable = usesPredictableShuffle(playlist, playerSetting);
+  const ordered = predictable
+    ? APMshuffle(playerSetting?.smartShuffle !== false)(playlist.songList)
+    : playlist.songList;
+  // 复用队列里已有的对象（带稳定 key），只换顺序
+  const songs = ordered.map(
+    (song) => queue.find((q) => q.id === song.id) ?? song,
+  );
+
+  const currentPlayingId = useNoxSetting.getState().currentPlayingId;
+  const index = songs.findIndex((song) => song.id === currentPlayingId);
+  useApp.getState().setparams({
+    ...params,
+    quietUpdate: true,
+    clearPriorAudioLists: true,
+    audioLists: songs,
+    newAudioListPlayIndex: index === -1 ? 0 : index,
+    // 队列已经是"播放顺序"了，RJKM 别再自己随机一遍
+    shuffleAlongAudioLists: predictable,
+    // 只重排：当前这首不要被切掉
+    keepCurrentAudioInList: index !== -1,
+  });
+};
+
+export default {};
